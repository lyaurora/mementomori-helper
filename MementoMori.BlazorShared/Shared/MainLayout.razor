@inject AccountSelection AccountSelection
@using MementoMori.Common.Localization
@using static MementoMori.Ortega.Share.Masters
@using System.Globalization
@using DynamicData.Binding
@using MementoMori.Option
@using ReactiveUI
@inherits LayoutComponentBase
@implements IDisposable
@inject AccountManager AccountManager
@inject IWritableOptions<AuthOption> AuthOption
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" IsDarkMode="false" ObserveSystemThemeChange="false" DefaultScrollbar="true"/>
<MudThemeProvider Theme="DarkTheme" IsDarkMode="true" ObserveSystemThemeChange="false" DefaultScrollbar="true"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Dense="false" Elevation="0" Class="app-header">
        <MudIconButton
            Icon="@Icons.Material.Filled.Menu"
            Color="Color.Inherit"
            Edge="Edge.Start"
            aria-label="展开或收起导航"
            @onclick="e => DrawerToggle()">
        </MudIconButton>
        <MudSelect T="long" Label="@ResourceStrings.SwitchAccount" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="app-account-select" @bind-Value="AccountSelection.CurrentUserId">
            @foreach (var account in AuthOption.Value.Accounts)
            {
                <MudSelectItem T="long" Value="account.UserId">@account.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSpacer />
        <MudSelect T="CultureInfo" Label="Select Language" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="app-language-select" @bind-Value="SelectedLanguage">
            <MudSelectItem Value="@(new CultureInfo("en-US"))"></MudSelectItem>
            <MudSelectItem Value="@(new CultureInfo("zh-CN"))"></MudSelectItem>
            <MudSelectItem Value="@(new CultureInfo("ja-JP"))"></MudSelectItem>
            <MudSelectItem Value="@(new CultureInfo("ko-KR"))"></MudSelectItem>
        </MudSelect>
        <MudMenu Disabled="@(!_themeReady)" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" title="@($"外观：{ThemeName}")" aria-label="外观模式" Disabled="@(!_themeReady)" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@(_themeMode == "system" ? Icons.Material.Filled.Check : Icons.Material.Filled.BrightnessAuto)" OnClick='() => SetThemeMode("system")'>跟随系统</MudMenuItem>
                <MudMenuItem Icon="@(_themeMode == "light" ? Icons.Material.Filled.Check : Icons.Material.Filled.LightMode)" OnClick='() => SetThemeMode("light")'>浅色</MudMenuItem>
                <MudMenuItem Icon="@(_themeMode == "dark" ? Icons.Material.Filled.Check : Icons.Material.Filled.DarkMode)" OnClick='() => SetThemeMode("dark")'>深色</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Target="_blank" Color="Color.Inherit" Href="https://github.com/lyaurora/mementomori-helper/" aria-label="GitHub 项目" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Class="app-nav">
        <MudDrawerHeader>
            <MudText Typo="Typo.h5" Class="mt-1">@ResourceStrings.GameAssistant</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="app-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _themeReady, _disposed;
    string _themeMode = "system";
    IDisposable? _accountManagerSubscription;
    string ThemeName => _themeMode switch { "light" => "浅色", "dark" => "深色", _ => "跟随系统" };
    string ThemeIcon => _themeMode switch { "light" => Icons.Material.Filled.LightMode, "dark" => Icons.Material.Filled.DarkMode, _ => Icons.Material.Filled.BrightnessAuto };
    static readonly MudTheme _theme = new()
    {
        LayoutProperties = new() { DefaultBorderRadius = "12px" },
        Typography = new()
        {
            Default = new() { FontFamily = ["system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "PingFang SC", "Microsoft YaHei UI", "Microsoft JhengHei", "Noto Sans CJK SC", "Noto Sans CJK TC", "WenQuanYi Zen Hei", "sans-serif"], FontSize = ".875rem", LineHeight = 1.6, LetterSpacing = "0" },
            Body1 = new() { FontSize = ".875rem", LineHeight = 1.6, LetterSpacing = "0" },
            Body2 = new() { FontSize = ".8125rem", LineHeight = 1.6, LetterSpacing = "0" },
            Subtitle1 = new() { FontSize = ".875rem", LineHeight = 1.6, LetterSpacing = "0" },
            Subtitle2 = new() { FontSize = ".8125rem", FontWeight = 600, LineHeight = 1.6, LetterSpacing = "0" },
            H5 = new() { FontSize = "1.25rem", FontWeight = 600, LineHeight = 1.5, LetterSpacing = "0" },
            H6 = new() { FontSize = "1.125rem", FontWeight = 600, LineHeight = 1.5, LetterSpacing = "0" },
            Button = new() { FontSize = ".875rem", FontWeight = 500, LineHeight = 1.5, LetterSpacing = "0", TextTransform = "none" },
            Input = new() { FontSize = ".875rem", LineHeight = 1.5, LetterSpacing = "0" },
            Caption = new() { FontSize = ".75rem", LineHeight = 1.6, LetterSpacing = "0" }
        },
        PaletteLight = new()
        {
            Primary = "#363636",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#616161",
            Info = "#526874",
            Success = "#397257",
            Warning = "#8A641F",
            Error = "#AD4B43",
            Background = "#F5F5F5",
            BackgroundGray = "#F7F7F7",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#242424",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#454545",
            DrawerIcon = "#777777",
            TextPrimary = "#242424",
            TextSecondary = "#686868",
            TextDisabled = "#929292",
            ActionDefault = "#696969",
            ActionDisabled = "#A0A0A0",
            ActionDisabledBackground = "#EFEFEF",
            LinesDefault = "#E4E4E4",
            LinesInputs = "#919191",
            TableLines = "#EAEAEA",
            TableStriped = "#FAFAFA",
            TableHover = "#F1F1F1",
            Divider = "#E4E4E4",
            DividerLight = "#EFEFEF",
            HoverOpacity = .07
        },
        PaletteDark = new()
        {
            Primary = "#E3E3E3",
            PrimaryContrastText = "#1A1A1A",
            Secondary = "#B8B8B8",
            SecondaryContrastText = "#1A1A1A",
            Info = "#B0C4CC",
            InfoContrastText = "#192629",
            Success = "#99C8AC",
            SuccessContrastText = "#1C2A21",
            Warning = "#D6BC87",
            WarningContrastText = "#2E271A",
            Error = "#E2A39C",
            ErrorContrastText = "#301C1A",
            Background = "#161616",
            BackgroundGray = "#252525",
            Surface = "#212121",
            AppbarBackground = "#1C1C1C",
            AppbarText = "#ECECEC",
            DrawerBackground = "#1C1C1C",
            DrawerText = "#D4D4D4",
            DrawerIcon = "#A4A4A4",
            TextPrimary = "#ECECEC",
            TextSecondary = "#B6B6B6",
            TextDisabled = "#838383",
            ActionDefault = "#C4C4C4",
            ActionDisabled = "#838383",
            ActionDisabledBackground = "#333333",
            LinesDefault = "#3D3D3D",
            LinesInputs = "#7F7F7F",
            TableLines = "#373737",
            TableStriped = "#272727",
            TableHover = "#333333",
            Divider = "#3D3D3D",
            DividerLight = "#303030",
            HoverOpacity = .1
        }
    };
    // Both palettes are available during prerender; theme.js selects one before the first paint.
    static readonly MudTheme DarkTheme = new()
    {
        PaletteDark = _theme.PaletteDark,
        LayoutProperties = _theme.LayoutProperties,
        Typography = _theme.Typography,
        PseudoCss = new() { Scope = ":root[data-theme=\"dark\"]" }
    };

    CultureInfo SelectedLanguage
    {
        get => AccountManager.CurrentCulture;
        set
        {
            AccountManager.CurrentCulture = value;
            NavigationManager.NavigateTo(NavigationManager.Uri, true);
        }
    }

    protected override void OnInitialized()
    {
        _accountManagerSubscription = AccountManager.WhenAnyPropertyChanged().Subscribe(_ => InvokeAsync(StateHasChanged));
    }

    public void Dispose()
    {
        _disposed = true;
        _accountManagerSubscription?.Dispose();
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("mementoTheme.getMode");
                if (saved is "light" or "dark") _themeMode = saved;
            }
            catch (JSException) { }
            if (_disposed) return;
            _themeReady = true;
            if (!_disposed) StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_disposed) { }
    }

    async Task SetThemeMode(string mode)
    {
        _themeMode = mode;
        try
        {
            if (!await JS.InvokeAsync<bool>("mementoTheme.setMode", mode))
                Snackbar.Add("主题已切换，但浏览器未能保存设置。", Severity.Warning);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { Snackbar.Add("主题已切换，但浏览器未能保存设置。", Severity.Warning); }
    }
}
