@using MementoMori.Ortega.Share
@implements IDisposable
@* Ticks on its own so the shop's product cards are not re-rendered every second. *@
<MudChip T="string" Class="shop-balance-chip shop-refresh-chip" Icon="@Icons.Material.Outlined.Schedule">@Text()</MudChip>

@code {
    [Parameter] public long ExpirationTimeStamp { get; set; }
    [Parameter] public EventCallback OnExpired { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private long _firedFor;

    protected override void OnInitialized() => _ = Tick();

    private async Task Tick()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(StateHasChanged);
                // Fire once per deadline; a stale deadline from the server cannot cause a request loop.
                if (Remaining() <= TimeSpan.Zero && _firedFor != ExpirationTimeStamp)
                {
                    _firedFor = ExpirationTimeStamp;
                    await InvokeAsync(() => OnExpired.InvokeAsync());
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private TimeSpan Remaining()
    {
        var span = TimeSpan.FromMilliseconds(ExpirationTimeStamp - DateTimeOffset.Now.ToUnixTimeMilliseconds());
        return span < TimeSpan.Zero ? TimeSpan.Zero : span;
    }

    private string Text()
    {
        var span = Remaining();
        var time = span.Days == 0
            ? Masters.TextResourceTable.Get("[CommonTimeFormatOnlyTime]", span.Hours, span.Minutes, span.Seconds)
            : Masters.TextResourceTable.Get("[CommonRemainTimeFull]", span.Days, span.Hours, span.Minutes, span.Seconds);
        return $"{Masters.TextResourceTable.Get("[ExchangeRemainingTimeLabel]")}: {time}";
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}
