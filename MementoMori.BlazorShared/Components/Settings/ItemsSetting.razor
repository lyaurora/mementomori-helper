@using MementoMori.Option
@using MementoMori.Ortega.Share
@using MementoMori.Jobs
@using MementoMori.Common.Localization
@using MementoMori.Common
@inject IWritableOptions<GameConfig> WritableGameConfig

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Inventory2" aria-hidden="true" /><span>@Masters.TextResourceTable.Get("[CommonFooterItemBoxButtonLabel]") <span class="panel-scope">@ResourceStrings.AllAccounts</span></span><SettingSaved @ref="_saved"/></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        <MudSelect Label="@ResourceStrings.AutoUseTargetItems" MultiSelection="true" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                   @bind-SelectedValues="AutoUseItemTypes" 
                   MultiSelectionTextFunc="list => string.Format(ResourceStrings.SelectedXItems, list.Count)">
            @* 命运盒是 SelectItem 宝箱，需要选择奖励，无法自动使用；只在界面隐藏 *@
            @foreach (var item in Enum.GetValues<GameConfig.AutoUseItemType>().Where(x => x != GameConfig.AutoUseItemType.ChestOfChance))
            {
                <MudSelectItem  Value="@item">@(ResourceStrings.ResourceManager.GetEnumString(item))</MudSelectItem>
            }
        </MudSelect> 
    </MudCardContent>
</MudCard>

@code {
    SettingSaved _saved = null!;


    IReadOnlyCollection<GameConfig.AutoUseItemType> AutoUseItemTypes
    {
        get => WritableGameConfig.Value.Items.AutoUseItemTypes;
        set => _saved.Run(() => WritableGameConfig.Update(x => x.Items.AutoUseItemTypes = value.ToList()));
    }

}
