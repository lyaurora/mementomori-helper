@using MementoMori.BlazorShared.Components
@using MementoMori.Ortega.Share
@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Common.Utils
@using MementoMori.Ortega.Share.Enums
@using MementoMori.Ortega.Share.Extensions
@using Microsoft.AspNetCore.Components.Forms

@inject IWritableOptions<PlayersOption> PlayersOptions
@inject IWritableOptions<GameConfig> WritableGameConfig
@inject MementoMori.WebUI.UI.AtlasManager Atlas
@inherits MementoMori.BlazorShared.Models.AccountComponent

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Groups" aria-hidden="true" /><span>@Masters.TextResourceTable.Get("[CommonHeaderLocalRaidLabel]") <span class="panel-scope is-account"><PlayerAvatar IconId="@(Funcs?.UserSyncData?.UserStatusDtoInfo?.MainCharacterIconId ?? 0)" Name="@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name)" Size="16" />@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name)</span></span><SettingSaved @ref="_saved"/></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        @* Two named choices: a switch whose label flips with its state never said what ON meant. *@
        <fieldset class="setting-choice-group" aria-label="@Tr("[CommonHeaderLocalRaidLabel]")">
            <InputRadioGroup TValue="bool" Name="local-raid-room" @bind-Value="selfCreateRoom" @bind-Value:after="Save">
                <label class="setting-choice">
                    <InputRadio TValue="bool" Value="false" />
                    <span>@Tr("[LocalRaidRoomSearchButtonJoinRandomRoom]")</span>
                </label>
                <label class="setting-choice">
                    <InputRadio TValue="bool" Value="true" />
                    <span>@Tr("[LocalRaidRoomSearchButtonCreateRoom]")</span>
                </label>
            </InputRadioGroup>
        </fieldset>
        @if (selfCreateRoom)
        {
            <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.Seconds_of_pre_battle_wait_time" @bind-Value="waitSeconds" @bind-Value:after="Save" Min="0" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
        }
        <div class="setting-section setting-weight-list">
            <MudText Class="setting-field-label">@ResourceStrings.Select_tasks_based_on_reward_quantity_and_weight</MudText>
            @foreach (var reward in _localRaidRewardItems)
            {
                var icon = Atlas.GetItemIcon(reward.ItemType, reward.ItemId);
                <div class="setting-weight-field">
                    @if (icon != null)
                    {
                        <span class="setting-item-art"><img src="@icon" @key="icon" width="22" height="22" loading="lazy" decoding="async" alt="" onerror="this.remove()"></span>
                    }
                    <MudNumericField T="double?" Label="@ItemUtil.GetItemName(reward.ItemType, reward.ItemId)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" DebounceInterval="500" Value="reward.Weight" ValueChanged="v => WeightChanged(reward, v)"/>
                </div>
            }
        </div>
    </MudCardContent>
</MudCard>


@code {
    SettingSaved _saved = null!;
    List<GameConfig.WeightedItem> _localRaidRewardItems;

    bool selfCreateRoom;
    int? waitSeconds; // null while the field is empty: keep the stored value

    protected override Task AccountChanged()
    {
        var playerOpt = PlayersOptions.Value.TryGetValue(NetworkManager.PlayerId, out var saved) ? saved : new PlayerOption {PlayerId = NetworkManager.PlayerId};
        _localRaidRewardItems = playerOpt.LocalRaid.RewardItems;
        if (_localRaidRewardItems.Count == 0)
        {
            // Copy: editing weights here must not change the list shared by every account.
            _localRaidRewardItems = WritableGameConfig.Value.LocalRaid.RewardItems.Select(d => new GameConfig.WeightedItem(d.ItemType, d.ItemId, d.Weight)).ToList();
            if (_localRaidRewardItems.Count == 0)
            {
                _localRaidRewardItems.AddRange(new[]
                {
                    new GameConfig.WeightedItem(ItemType.ExchangePlaceItem, 4, 4), // 符石兑换券
                    new GameConfig.WeightedItem(ItemType.CharacterTrainingMaterial, 2, 3), // 潜能宝珠
                    new GameConfig.WeightedItem(ItemType.EquipmentReinforcementItem, 2, 2.5), // 强化秘药
                    new GameConfig.WeightedItem(ItemType.CharacterTrainingMaterial, 1, 2), // 经验珠
                    new GameConfig.WeightedItem(ItemType.EquipmentReinforcementItem, 1, 1), // 强化水
                });
            }
        }

        selfCreateRoom = playerOpt.LocalRaid.SelfCreateRoom;
        waitSeconds = playerOpt.LocalRaid.WaitSeconds;

        return Task.CompletedTask;
    }


    // An emptied weight field (mid-typing) keeps the old weight instead of saving 0.
    private void WeightChanged(GameConfig.WeightedItem reward, double? weight)
    {
        if (weight is not { } w) return;
        reward.Weight = w;
        Save();
    }

    private void Save() => _saved.Run(() => PlayersOptions.Update(opt =>
    {
        var playerOpt = opt.GetOrAdd(NetworkManager.PlayerId, (id) => new PlayerOption() {PlayerId = id});
        playerOpt.LocalRaid.RewardItems = _localRaidRewardItems;
        playerOpt.LocalRaid.SelfCreateRoom = selfCreateRoom;
        if (waitSeconds is { } wait) playerOpt.LocalRaid.WaitSeconds = wait;
    }));

}
