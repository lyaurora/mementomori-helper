@using MementoMori.BlazorShared.Components
@using MementoMori.Ortega.Share
@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Common.Utils
@using MementoMori.Ortega.Share.Enums
@using MementoMori.Ortega.Share.Extensions
@using Microsoft.AspNetCore.Components.Forms

@inject IWritableOptions<PlayersOption> PlayersOptions
@inject IWritableOptions<GameConfig> WritableGameConfig
@inject MementoMori.WebUI.UI.AtlasManager Atlas
@inherits MementoMori.BlazorShared.Models.AccountComponent

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Groups" aria-hidden="true" /><span>@Masters.TextResourceTable.Get("[CommonHeaderLocalRaidLabel]") <span class="panel-scope is-account"><PlayerAvatar IconId="@(Funcs?.UserSyncData?.UserStatusDtoInfo?.MainCharacterIconId ?? 0)" Name="@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name)" Size="16" />@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name)</span></span><SettingSaved @ref="_saved"/></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        @* Two named choices: a switch whose label flips with its state never said what ON meant. *@
        <fieldset class="setting-choice-group" aria-label="@Tr("[CommonHeaderLocalRaidLabel]")">
            <InputRadioGroup TValue="bool" Name="local-raid-room" @bind-Value="selfCreateRoom" @bind-Value:after="Save">
                <label class="setting-choice">
                    <InputRadio TValue="bool" Value="false" />
                    <span>@Tr("[LocalRaidRoomSearchButtonJoinRandomRoom]")</span>
                </label>
                <label class="setting-choice">
                    <InputRadio TValue="bool" Value="true" />
                    <span>@Tr("[LocalRaidRoomSearchButtonCreateRoom]")</span>
                </label>
            </InputRadioGroup>
        </fieldset>

        @if (!selfCreateRoom)
        {
            <MudSwitch Class="settings-toggle" LabelPlacement="Placement.Start" Label="@ResourceStrings.LocalRaidHostWhenNoRoom" @bind-Value="hostWhenNoRoom" @bind-Value:after="Save" Color="Color.Primary"></MudSwitch>
        }

        <div class="setting-section">
            <MudText Class="setting-field-label">@ResourceStrings.LocalRaidTimeoutsAndLimits</MudText>
            <div class="setting-pair-grid">
                @if (!selfCreateRoom)
                {
                    <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidJoinWaitMinutes" @bind-Value="joinWaitMinutes" @bind-Value:after="Save" Min="1" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
                    <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidRoomWaitMinutes" @bind-Value="roomWaitMinutes" @bind-Value:after="Save" Min="1" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
                }

                @if (selfCreateRoom || hostWhenNoRoom)
                {
                    <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidWaitSeconds" @bind-Value="waitSeconds" @bind-Value:after="Save" Min="0" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
                    <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidMaxSoloLosses" HelperText="@ResourceStrings.LocalRaidMaxSoloLossesHint" @bind-Value="maxSoloLosses" @bind-Value:after="Save" Min="0" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
                }

                <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidMaxTaskMinutes" @bind-Value="maxTaskMinutes" @bind-Value:after="Save" Min="1" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
                <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidQuestLevel" HelperText="@ResourceStrings.LocalRaidQuestLevelHint" @bind-Value="questLevel" @bind-Value:after="Save" Min="0" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
            </div>
        </div>

        <div class="setting-section">
            <MudSwitch Class="settings-toggle" LabelPlacement="Placement.Start" Label="@ResourceStrings.LocalRaidDropToLowerQuest" @bind-Value="dropToLowerQuest" @bind-Value:after="Save" Color="Color.Primary"></MudSwitch>
            @if (dropToLowerQuest && !selfCreateRoom)
            {
                <MudNumericField InputMode="InputMode.numeric" T="int?" Label="@ResourceStrings.LocalRaidLowerQuestAfterMinutes" @bind-Value="lowerQuestAfterMinutes" @bind-Value:after="Save" Min="1" DebounceInterval="500" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
            }
        </div>

        <div class="setting-section setting-weight-list">
            <MudText Class="setting-field-label">@ResourceStrings.Select_tasks_based_on_reward_quantity_and_weight</MudText>
            @foreach (var reward in _localRaidRewardItems)
            {
                var icon = Atlas.GetItemIcon(reward.ItemType, reward.ItemId);
                <div class="setting-weight-field">
                    @if (icon != null)
                    {
                        <span class="setting-item-art"><img src="@icon" @key="icon" width="22" height="22" loading="lazy" decoding="async" alt="" onerror="this.remove()"></span>
                    }
                    <MudNumericField T="double?" Label="@ItemUtil.GetItemName(reward.ItemType, reward.ItemId)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" DebounceInterval="500" Value="reward.Weight" ValueChanged="v => WeightChanged(reward, v)"/>
                </div>
            }
        </div>
    </MudCardContent>
</MudCard>


@code {
    SettingSaved _saved = null!;
    List<GameConfig.WeightedItem> _localRaidRewardItems = [];

    bool selfCreateRoom;
    bool hostWhenNoRoom;
    bool dropToLowerQuest;
    // Nullable while an input is emptied mid-typing so the stored value is kept instead of overwritten with 0.
    int? waitSeconds;
    int? joinWaitMinutes;
    int? roomWaitMinutes;
    int? maxSoloLosses;
    int? maxTaskMinutes;
    int? lowerQuestAfterMinutes;
    int? questLevel;

    protected override Task AccountChanged()
    {
        var playerOpt = PlayersOptions.Value.TryGetValue(NetworkManager.PlayerId, out var saved) ? saved : new PlayerOption {PlayerId = NetworkManager.PlayerId};
        _localRaidRewardItems = playerOpt.LocalRaid.RewardItems;
        if (_localRaidRewardItems.Count == 0)
        {
            // Copy: editing weights here must not change the list shared by every account.
            _localRaidRewardItems = WritableGameConfig.Value.LocalRaid.RewardItems.Select(d => new GameConfig.WeightedItem(d.ItemType, d.ItemId, d.Weight)).ToList();
            if (_localRaidRewardItems.Count == 0)
            {
                _localRaidRewardItems.AddRange(new[]
                {
                    new GameConfig.WeightedItem(ItemType.ExchangePlaceItem, 4, 4), // 符石兑换券
                    new GameConfig.WeightedItem(ItemType.CharacterTrainingMaterial, 2, 3), // 潜能宝珠
                    new GameConfig.WeightedItem(ItemType.EquipmentReinforcementItem, 2, 2.5), // 强化秘药
                    new GameConfig.WeightedItem(ItemType.CharacterTrainingMaterial, 1, 2), // 经验珠
                    new GameConfig.WeightedItem(ItemType.EquipmentReinforcementItem, 1, 1), // 强化水
                });
            }
        }

        selfCreateRoom = playerOpt.LocalRaid.SelfCreateRoom;
        waitSeconds = playerOpt.LocalRaid.WaitSeconds;
        hostWhenNoRoom = playerOpt.LocalRaid.HostWhenNoRoom;
        joinWaitMinutes = playerOpt.LocalRaid.JoinWaitMinutes;
        roomWaitMinutes = playerOpt.LocalRaid.RoomWaitMinutes;
        maxSoloLosses = playerOpt.LocalRaid.MaxSoloLosses;
        maxTaskMinutes = playerOpt.LocalRaid.MaxTaskMinutes;
        dropToLowerQuest = playerOpt.LocalRaid.DropToLowerQuest;
        lowerQuestAfterMinutes = playerOpt.LocalRaid.LowerQuestAfterMinutes;
        questLevel = playerOpt.LocalRaid.QuestLevel;

        return Task.CompletedTask;
    }


    // An emptied weight field (mid-typing) keeps the old weight instead of saving 0.
    private void WeightChanged(GameConfig.WeightedItem reward, double? weight)
    {
        if (weight is not { } w) return;
        reward.Weight = w;
        Save();
    }

    private void Save() => _saved.Run(() => PlayersOptions.Update(opt =>
    {
        var playerOpt = opt.GetOrAdd(NetworkManager.PlayerId, (id) => new PlayerOption() {PlayerId = id});
        playerOpt.LocalRaid.RewardItems = _localRaidRewardItems;
        playerOpt.LocalRaid.SelfCreateRoom = selfCreateRoom;
        playerOpt.LocalRaid.HostWhenNoRoom = hostWhenNoRoom;
        playerOpt.LocalRaid.DropToLowerQuest = dropToLowerQuest;
        if (waitSeconds is { } wait) playerOpt.LocalRaid.WaitSeconds = (waitSeconds = Math.Max(0, wait)).Value;
        if (joinWaitMinutes is { } joinMin) playerOpt.LocalRaid.JoinWaitMinutes = (joinWaitMinutes = Math.Max(1, joinMin)).Value;
        if (roomWaitMinutes is { } roomMin) playerOpt.LocalRaid.RoomWaitMinutes = (roomWaitMinutes = Math.Max(1, roomMin)).Value;
        if (maxSoloLosses is { } losses) playerOpt.LocalRaid.MaxSoloLosses = (maxSoloLosses = Math.Max(0, losses)).Value;
        if (maxTaskMinutes is { } taskMin) playerOpt.LocalRaid.MaxTaskMinutes = (maxTaskMinutes = Math.Max(1, taskMin)).Value;
        if (lowerQuestAfterMinutes is { } lowerMin) playerOpt.LocalRaid.LowerQuestAfterMinutes = (lowerQuestAfterMinutes = Math.Max(1, lowerMin)).Value;
        if (questLevel is { } level) playerOpt.LocalRaid.QuestLevel = (questLevel = Math.Max(0, level)).Value;
    }));

}
