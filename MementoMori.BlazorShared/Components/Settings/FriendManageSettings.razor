@using MementoMori.Ortega.Share
@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Share.Data.ApiInterface.Friend
@using MementoMori.Ortega.Share.Data.Player
@using MementoMori.Ortega.Share.Enums
@using MementoMori.Ortega.Share.Extensions

@inject ISnackbar Snackbar
@inject IWritableOptions<PlayersOption> PlayersOptions
@inherits MementoMori.BlazorShared.Models.AccountComponent

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Group" aria-hidden="true" /><span>@Masters.TextResourceTable.Get("[FriendTabFriend]") <span class="panel-scope">(@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name))</span></span></MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Class="setting-save-button" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveFriendManageConfig">@Masters.TextResourceTable.Get("[CommonSaveLabel]")</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        <MudSwitch T="bool" Class="settings-toggle" LabelPosition="LabelPosition.Start" Label="@ResourceStrings.Remove_friends_inactive_for_7_days" Value="_autoRemoveFriend" ValueChanged="autoDeleteChanged" Color="Color.Primary"></MudSwitch>
        <MudSelect Label="@ResourceStrings.Auto_remove_whitelist" MultiSelection="true" T="FriendInfo" Disabled="@(!_autoRemoveFriend || _friendList.Count == 0)" @bind-SelectedValues="_friendWhiteList" MultiSelectionTextFunc="list => string.Format(ResourceStrings.SelectedXItems, list.Count)" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var friend in _friendList)
            {
                <MudSelectItem Value="friend">
                    <MudText>@($"{friend.Name}({friend.Id})")</MudText>
                </MudSelectItem>
            }
        </MudSelect>
        <MudSwitch T="bool" Class="settings-toggle" LabelPosition="LabelPosition.Start" Label="@ResourceStrings.Auto_accept_friend_requests" @bind-Value="_autoAcceptNewFriend" Color="Color.Primary"></MudSwitch>
        <MudSwitch T="bool" Class="settings-toggle" LabelPosition="LabelPosition.Start" Label="@ResourceStrings.Auto_send_friend_requests" @bind-Value="_autoApplyFriend" Color="Color.Primary"></MudSwitch>
    </MudCardContent>
</MudCard>


@code {
    bool _autoRemoveFriend;
    bool _autoAcceptNewFriend;
    bool _autoApplyFriend;

    List<FriendInfo> _friendList = [];
    IEnumerable<FriendInfo> _friendWhiteList = [];

    protected override async Task AccountChanged()
    {
        _friendList = [];
        _friendWhiteList = [];
        var playerOpt = PlayersOptions.Value.TryGetValue(NetworkManager.PlayerId, out var v) ? v : new PlayerOption {PlayerId = NetworkManager.PlayerId};
        if (NetworkManager.PlayerId > 0)
        {
            await autoDeleteChanged(playerOpt.FriendManage.AutoRemoveInactiveFriend);
        }

        _autoRemoveFriend = playerOpt.FriendManage.AutoRemoveInactiveFriend;
        _autoAcceptNewFriend = playerOpt.FriendManage.AutoAcceptFriendRequest;
        _autoApplyFriend = playerOpt.FriendManage.AutoSendFriendRequest;
    }


    private void SaveFriendManageConfig()
    {
        PlayersOptions.Update(opt =>
        {
            var playerOpt = opt.GetOrAdd(NetworkManager.PlayerId, (id) => new PlayerOption() {PlayerId = id});
            // Keep the stored whitelist when the friend list was never loaded (fetch failed or auto-remove off).
            if (_friendList.Count > 0) playerOpt.FriendManage.AutoRemoveWhitelist = _friendWhiteList.Select(d => d.Id).ToList();
            playerOpt.FriendManage.AutoRemoveInactiveFriend = _autoRemoveFriend;
            playerOpt.FriendManage.AutoAcceptFriendRequest = _autoAcceptNewFriend;
            playerOpt.FriendManage.AutoSendFriendRequest = _autoApplyFriend;
        });
        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add(ResourceStrings.Save_successful, Severity.Success);
    }

    public class FriendInfo
    {
        public long Id { get; set; }
        public string Name { get; set; }
        public bool IsWhiteList { get; set; }
    }

    private async Task autoDeleteChanged(bool obj)
    {
        _autoRemoveFriend = obj;
        try
        {
            if (obj)
            {
                var playerOpt = PlayersOptions.Value.TryGetValue(NetworkManager.PlayerId, out var v) ? v : new PlayerOption {PlayerId = NetworkManager.PlayerId};
                var response = await Funcs.GetResponse<GetPlayerInfoListRequest, GetPlayerInfoListResponse>(new GetPlayerInfoListRequest() {FriendInfoType = FriendInfoType.Friend});
                _friendList = response.PlayerInfoList.Select(d => new FriendInfo() {Id = d.PlayerId, Name = d.PlayerName, IsWhiteList = false}).ToList();
                foreach (var l in playerOpt.FriendManage.AutoRemoveWhitelist)
                {
                    var friendInfo = _friendList.Find(d => d.Id == l);
                    if (friendInfo != null)
                    {
                        friendInfo.IsWhiteList = true;
                    }
                    else
                    {
                        _friendList.Add(new FriendInfo() {Id = l, Name = ResourceStrings.Unknown, IsWhiteList = true});
                    }
                }

                _friendWhiteList = _friendList.Where(f => f.IsWhiteList).ToList();
            }
        }
        catch (Exception e)
        {
            // ignored
        }
    }

}
