@using MementoMori.Option
@using MementoMori.Ortega.Share
@using MementoMori.Jobs
@using MementoMori.Common.Localization
@inject IWritableOptions<GameConfig> WritableGameConfig
@inject TimeZoneAwareJobRegister TimeZoneAwareJobRegister
@inject AccountSelection AccountSelection

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Schedule" aria-hidden="true" /><span>@ResourceStrings.AutoJobCrons <span class="panel-scope">@ResourceStrings.AllAccounts</span></span></MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Href="https://www.freeformatter.com/cron-expression-generator-quartz.html"
                       Target="_blank"
                       Size="Size.Small" Class="setting-save-button"
                       Variant="Variant.Outlined"
                       Style="text-transform:none"
                       StartIcon="@Icons.Material.Filled.Help"
                       Color="Color.Primary">@ResourceStrings.CronExpression</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="cron-list">
        @* One row per job; the editor opens inline for a single job at a time. *@
        @foreach (var job in Jobs)
        {
            var open = _open == job.Label;
            var cron = job.Get();
            var summary = CronPicker.Describe(cron);
            <div class="cron-row @(open ? "is-open" : null)">
                <button type="button" class="cron-row-head" aria-expanded="@(open ? "true" : "false")" title="@ResourceStrings.EditSchedule" @onclick="() => _open = open ? null : job.Label">
                    <span class="cron-row-name">@job.Label</span>
                    <span class="cron-row-sum @(summary == null ? "is-raw" : null)">@(summary ?? cron)</span>
                    <span class="cron-row-next">@CronPicker.NextRuns(cron, AccountSelection, 1, false).FirstOrDefault()</span>
                    <MudIcon Class="cron-row-icon" Icon="@(open ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.Edit)" Size="Size.Small" aria-hidden="true" />
                </button>
                @if (open)
                {
                    <CronPicker Label="@job.Label" Value="@cron" ValueChanged="v => Changed(job, v)" Default="@job.Default"/>
                }
            </div>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public EventCallback OnJobsChanged { get; set; }

    GameConfig.AutoJobModel defaultValue = new();
    string? _open;

    record Job(string Label, Func<string> Get, Action<string> Set, string Default);

    IEnumerable<Job> Jobs =>
    [
        new(ResourceStrings.DailyJob, () => AutoJob__DailyJobCron, v => AutoJob__DailyJobCron = v, defaultValue.DailyJobCron),
        new(ResourceStrings.RewardClaimJob, () => AutoJob__HourlyJobCron, v => AutoJob__HourlyJobCron = v, defaultValue.HourlyJobCron),
        new(Masters.TextResourceTable.Get("[CommonHeaderLocalPvpLabel]"), () => AutoJob__PvpJobCron, v => AutoJob__PvpJobCron = v, defaultValue.PvpJobCron),
        new(Masters.TextResourceTable.Get("[CommonHeaderGlobalPvpLabel]"), () => AutoJob__LegendLeagueJobCron, v => AutoJob__LegendLeagueJobCron = v, defaultValue.LegendLeagueJobCron),
        new(Masters.TextResourceTable.Get("[GuildRaidReleaseConfirmTitle]"), () => AutoJob__GuildRaidBossReleaseCron, v => AutoJob__GuildRaidBossReleaseCron = v, defaultValue.GuildRaidBossReleaseCron),
        new(ResourceStrings.ShopAutoBuyItems, () => AutoJob__AutoBuyShopItemJobCron, v => AutoJob__AutoBuyShopItemJobCron = v, defaultValue.AutoBuyShopItemJobCron),
        new(Masters.TextResourceTable.Get("[CommonHeaderLocalRaidLabel]"), () => AutoJob__AutoLocalRaidJobCron, v => AutoJob__AutoLocalRaidJobCron = v, defaultValue.AutoLocalRaidJobCron),
        new(Tr("[GachaRelicChangeTitle]"), () => AutoJob__AutoChangeGachaRelicJobCron, v => AutoJob__AutoChangeGachaRelicJobCron = v, defaultValue.AutoChangeGachaRelicJobCron),
        new(ResourceStrings.Auto_draw_10_times__up_to_3_draws_, () => AutoJob__AutoDrawGachaRelicJobCron, v => AutoJob__AutoDrawGachaRelicJobCron = v, defaultValue.AutoDrawGachaRelicJobCron),
    ];

    // Stays open while editing: daily hours / weekdays are multi-select, so collapsing after each valid change would fight the user.
    async Task Changed(Job job, string cron)
    {
        job.Set(cron);
        await RegisterAllJobs();
    }

    // Invalid text is shown as an error and never saved, so the running schedule keeps its last valid cron.
    static readonly Func<string, string?> CronError = value => !string.IsNullOrWhiteSpace(value) && Quartz.CronExpression.IsValidExpression(value) ? null : ResourceStrings.InvalidCronExpression;

    private async Task RegisterAllJobs()
    {
        await TimeZoneAwareJobRegister.RegisterAllJobs();
        await OnJobsChanged.InvokeAsync();
    }

    public string AutoJob__DailyJobCron
    {
        get => WritableGameConfig.Value.AutoJob.DailyJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.DailyJobCron = value); }
    }

    public string AutoJob__HourlyJobCron
    {
        get => WritableGameConfig.Value.AutoJob.HourlyJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.HourlyJobCron = value); }
    }

    public string AutoJob__PvpJobCron
    {
        get => WritableGameConfig.Value.AutoJob.PvpJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.PvpJobCron = value); }
    }

    public string AutoJob__LegendLeagueJobCron
    {
        get => WritableGameConfig.Value.AutoJob.LegendLeagueJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.LegendLeagueJobCron = value); }
    }

    public string AutoJob__GuildRaidBossReleaseCron
    {
        get => WritableGameConfig.Value.AutoJob.GuildRaidBossReleaseCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.GuildRaidBossReleaseCron = value); }
    }

    public string AutoJob__AutoBuyShopItemJobCron
    {
        get => WritableGameConfig.Value.AutoJob.AutoBuyShopItemJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.AutoBuyShopItemJobCron = value); }
    }

    public string AutoJob__AutoLocalRaidJobCron
    {
        get => WritableGameConfig.Value.AutoJob.AutoLocalRaidJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.AutoLocalRaidJobCron = value); }
    }

    public string AutoJob__AutoDeployGuildDefenseJobCron
    {
        get => WritableGameConfig.Value.AutoJob.AutoDeployGuildDefenseJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.AutoDeployGuildDefenseJobCron = value); }
    }

    public string AutoJob__AutoChangeGachaRelicJobCron
    {
        get => WritableGameConfig.Value.AutoJob.AutoChangeGachaRelicJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.AutoChangeGachaRelicJobCron = value); }
    }

    public string AutoJob__AutoDrawGachaRelicJobCron
    {
        get => WritableGameConfig.Value.AutoJob.AutoDrawGachaRelicJobCron;
        set { if (CronError(value) == null) WritableGameConfig.Update(x => x.AutoJob.AutoDrawGachaRelicJobCron = value); }
    }

}
