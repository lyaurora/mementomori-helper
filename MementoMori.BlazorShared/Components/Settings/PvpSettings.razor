@inject ISnackbar Snackbar
@inject IWritableOptions<PlayersOption> PlayersOptions
@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Share
@using MementoMori.Ortega.Share.Enums
@using MementoMori.Ortega.Share.Extensions
@using Microsoft.AspNetCore.Components.Forms
@inherits MementoMori.BlazorShared.Models.AccountComponent
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.SportsKabaddi" aria-hidden="true" /><span>@name <span class="panel-scope">(@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name))</span></span></MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="setting-save-button" StartIcon="@Icons.Material.Filled.Save" OnClick="() => SavePlayerSetting()">@Masters.TextResourceTable.Get("[CommonSaveLabel]")</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        <fieldset class="setting-choice-group">
            <legend>@ResourceStrings.Opponent_Selection_Strategy</legend>
            <InputRadioGroup TValue="TargetSelectStrategy" Name="@($"pvp-strategy-{LeagueType}")" @bind-Value="pvpOption.SelectStrategy">
                <label class="setting-choice">
                    <InputRadio TValue="TargetSelectStrategy" Value="TargetSelectStrategy.Random" />
                    <span>@ResourceStrings.Random</span>
                </label>
                <label class="setting-choice">
                    <InputRadio TValue="TargetSelectStrategy" Value="TargetSelectStrategy.LowestBattlePower" />
                    <span>@ResourceStrings.Min_Battle_Power</span>
                </label>
                <label class="setting-choice">
                    <InputRadio TValue="TargetSelectStrategy" Value="TargetSelectStrategy.HighestBattlePower" />
                    <span>@ResourceStrings.Max_Battle_Power</span>
                </label>
            </InputRadioGroup>
        </fieldset>
        <MudTextField Label="@ResourceStrings.Exclude_player_IDs__comma_separated_" @bind-Value="ExcludePlayerIds" Variant="Variant.Outlined" Margin="Margin.Dense"></MudTextField>
        <MudList T="CharacterFilter" ReadOnly="true" Class="setting-filter-list">
            <MudListSubheader Class="setting-filter-header">
                <MudText Inline="true">@ResourceStrings.Character_Filter</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => OpenCreateFilter()">@ResourceStrings.Add</MudButton>
            </MudListSubheader>
            @foreach (var filter in pvpOption.CharacterFilters)
            {
                var characterName = Masters.CharacterTable.GetById(filter.CharacterId).GetCombinedName();
                var battleParameterName = Masters.TextResourceTable.Get(filter.BattleParameterType);
                var desc = filter.FilterStrategy switch
                {
                    CharacterFilterStrategy.Character => string.Format(ResourceStrings.Exclude__0_, characterName),
                    CharacterFilterStrategy.PropertyMoreThanSelf => string.Format(ResourceStrings.Exclude__battleParameterName__higher_than__characterName_, battleParameterName, characterName)
                };
                <MudListItem Dense="true" T="CharacterFilter" Class="setting-filter-item">
                    <MudStack Row="true" Spacing="1" Class="setting-filter-row align-content-center align-center">
                        <MudText Inline="true" Class="setting-filter-description">@desc</MudText>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Settings" title="@ResourceStrings.Settings" aria-label="@ResourceStrings.Settings" OnClick="() => OpenSetting(filter)"></MudIconButton>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" title="@Masters.TextResourceTable.Get("[MyPagePresentDetailDeleteButton]")" aria-label="@Masters.TextResourceTable.Get("[MyPagePresentDetailDeleteButton]")" OnClick="() => DeleteFilter(filter)"></MudIconButton>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </MudCardContent>
</MudCard>

<MudDialog Class="app-form-dialog" @bind-Visible="settingDialogOpen" Options="@(new DialogOptions {CloseButton = true, FullWidth = true, MaxWidth = MaxWidth.Small})">
    <TitleContent>
        @ResourceStrings.Character_Filter
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Class="setting-dialog-fields">
            <MudSelect Label="@ResourceStrings.Filtering_strategy" @bind-Value="settingFilter.FilterStrategy" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="CharacterFilterStrategy.Character">@ResourceStrings.Exclude_character</MudSelectItem>
                <MudSelectItem Value="CharacterFilterStrategy.PropertyMoreThanSelf">@ResourceStrings.Exclude_enemy_character_with_higher_stats_in_the_same_attribute_as_ours</MudSelectItem>
            </MudSelect>
            <MudSelect Label="@Masters.TextResourceTable.Get("[CommonFooterCharacterButtonLabel]")" @bind-Value="settingFilter.CharacterId" Strict="true" Placeholder="@ResourceStrings.NotSelected" FullWidth="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="long" Value="0L" Disabled="true">@ResourceStrings.NotSelected</MudSelectItem>
                @foreach (var character in Masters.CharacterTable.GetArray())
                {
                    <MudSelectItem Value="@character.Id">@character.GetCombinedName()</MudSelectItem>
                }
            </MudSelect>
            @if (settingFilter.FilterStrategy == CharacterFilterStrategy.PropertyMoreThanSelf)
            {
                <MudSelect Label="@Masters.TextResourceTable.Get("[CharacterDetailTabBattleParameter]")" @bind-Value="settingFilter.BattleParameterType" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var battleParameterType in Enum.GetValues(typeof(BattleParameterType)).Cast<BattleParameterType>())
                    {
                        <MudSelectItem Value="@battleParameterType">@Masters.TextResourceTable.Get(battleParameterType)</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => ConfirmFilter()">@Masters.TextResourceTable.Get("[CommonDecisionLabel]")</MudButton>
    </DialogActions>
</MudDialog>


@code {

    [Parameter]
    public int LeagueType { get; set; }

    Func<PlayerOption, PvpOption> pvpOptionSelector;
    string name;
    PlayerOption playerOption;
    PvpOption pvpOption;

    CharacterFilter settingFilter;
    bool settingDialogOpen;

    string ExcludePlayerIds
    {
        get => string.Join(",", pvpOption.ExcludePlayerIds);
        set => pvpOption.ExcludePlayerIds = value.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(x => long.TryParse(x, out var n) ? n : 0).Where(x => x > 0).ToList();
    }


    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (LeagueType == 0)
        {
            pvpOptionSelector = x => x.BattleLeague;
            name = Masters.TextResourceTable.Get("[CommonHeaderLocalPvpLabel]");
        }
        else
        {
            pvpOptionSelector = x => x.LegendLeague;
            name = Masters.TextResourceTable.Get("[CommonHeaderGlobalPvpLabel]");
        }
    }

    protected override Task AccountChanged()
    {
        playerOption = PlayersOptions.Value.TryGetValue(NetworkManager.PlayerId, out var opt) ? opt : new PlayerOption {PlayerId = NetworkManager.PlayerId};
        pvpOption = Clone(pvpOptionSelector(playerOption));
        return Task.CompletedTask;
    }

    // Edit a copy so unsaved edits don't leak into running jobs through the live PlayersOption.
    private static PvpOption Clone(PvpOption option) => Newtonsoft.Json.JsonConvert.DeserializeObject<PvpOption>(Newtonsoft.Json.JsonConvert.SerializeObject(option))!;

    private void OpenCreateFilter()
    {
        settingFilter = new CharacterFilter();
        settingDialogOpen = true;
    }

    private void OpenSetting(CharacterFilter filter)
    {
        settingFilter = filter;
        settingDialogOpen = true;
    }

    private void DeleteFilter(CharacterFilter filter)
    {
        pvpOption.CharacterFilters.Remove(filter);
        SavePlayerSetting();
    }

    private void ConfirmFilter()
    {
        if (settingFilter.CharacterId == 0)
        {
            return;
        }

        if (!pvpOption.CharacterFilters.Contains(settingFilter))
        {
            pvpOption.CharacterFilters.Add(settingFilter);
        }

        settingDialogOpen = false;
    }

    private void SavePlayerSetting()
    {
        PlayersOptions.Update(opt =>
        {
            var playerOpt = opt.GetOrAdd(NetworkManager.PlayerId, id => new PlayerOption {PlayerId = id});
            if (LeagueType == 0)
            {
                playerOpt.BattleLeague = Clone(pvpOption);
            }
            else
            {
                playerOpt.LegendLeague = Clone(pvpOption);
            }
        });

        Snackbar.Clear();
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        Snackbar.Add(ResourceStrings.Save_successful, Severity.Success);
    }

}
