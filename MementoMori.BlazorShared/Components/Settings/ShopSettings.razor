@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Common.Utils
@using MementoMori.Ortega.Share
@using MementoMori.Ortega.Share.Data.Item
@using MementoMori.Ortega.Share.Enums
@inject IWritableOptions<GameConfig> WritableGameConfig

@inject MementoMori.WebUI.UI.AtlasManager Atlas
@inherits MementoMori.BlazorShared.Models.AccountComponent


<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <!--商城-->
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Storefront" aria-hidden="true" /><span>@Masters.TextResourceTable.Get("[CommonHeaderExchangeLabel]") <span class="panel-scope">@ResourceStrings.AllAccounts</span></span></MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Class="setting-save-button" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Restore" OnClick="ShopAutoBuyRestoreDefault">@ResourceStrings.ResettoDefault</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        <MudText Class="setting-field-label">@ResourceStrings.ShopAutoBuyItems</MudText>
        <div class="setting-item-list">
            @foreach (var item in ShopAutoBuyItems)
            {
                var buy = item.BuyItem == null ? ResourceStrings.AnyItems : $"{ItemUtil.GetItemName(item.BuyItem.ItemType, item.BuyItem.ItemId)}×{item.BuyItem.ItemCount}";
                var amountDesc = item.ConsumeItem?.ItemCount == 0 ? ResourceStrings.Any_amount : item.ConsumeItem?.ItemCount.ToString();
                var consume = item.ConsumeItem == null ? ResourceStrings.AnyItems : $"{ItemUtil.GetItemName(item.ConsumeItem.ItemType, item.ConsumeItem.ItemId)}×{amountDesc}";
                var text = string.Format(ResourceStrings.BuyWith, consume, buy);
                var iconItem = item.BuyItem ?? item.ConsumeItem;
                var icon = iconItem == null ? null : Atlas.GetItemIcon(iconItem.ItemType, iconItem.ItemId);
                <div class="setting-item-row">
                    @if (icon != null)
                    {
                        <span class="setting-item-art"><img src="@icon" @key="icon" width="28" height="28" loading="lazy" decoding="async" alt="" onerror="this.remove()"></span>
                    }
                    <span class="setting-item-text shop-rule-text"><span class="shop-rule-sentence">@text.Replace("×", "\u2060×\u2060")</span> @if (item.MinDiscountPercent > 0) { <span class="shop-rule-discount">@($"{item.MinDiscountPercent}{Masters.TextResourceTable.Get("[ShopDiscountLabel]")}")</span> }</span>
                    <MudIconButton Class="setting-item-remove" Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@($"{Masters.TextResourceTable.Get("[BulkBuyProductRemoveCartItemButtonLabel]")}: {text}")" OnClick="() => RemoveShopAutoBuyItem(item)" />
                </div>
            }
        </div>
    </MudCardContent>
</MudCard>


@code {

    public List<GameConfig.ShopAutoBuyItem> ShopAutoBuyItems
    {
        get => WritableGameConfig.Value.Shop.AutoBuyItems;
        set => WritableGameConfig.Update(x => x.Shop.AutoBuyItems = value);
    }

    private void RemoveShopAutoBuyItem(GameConfig.ShopAutoBuyItem item)
    {
        var tmp = ShopAutoBuyItems.ToList();
        tmp.Remove(item);
        ShopAutoBuyItems = tmp;
    }

    private void ShopAutoBuyRestoreDefault()
    {
        ShopAutoBuyItems = new List<GameConfig.ShopAutoBuyItem>()
        {
            new() {BuyItem = new UserItem() {ItemType = ItemType.EquipmentRarityCrystal, ItemId = 1, ItemCount = 5}, ShopTabId = 1, MinDiscountPercent = 20},
            new() {ShopTabId = 1, ConsumeItem = new UserItem() {ItemType = ItemType.Gold, ItemId = 1}}
        };
    }

}
