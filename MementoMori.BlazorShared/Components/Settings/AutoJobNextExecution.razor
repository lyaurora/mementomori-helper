@using Quartz
@using Quartz.Impl.Matchers
@using System.Reactive.Linq
@using Microsoft.Extensions.Logging
@using MementoMori.Common.Localization
@inherits MementoMori.BlazorShared.Models.AccountComponent
@inject ISchedulerFactory SchedulerFactory
@using MementoMori.Option
@using MementoMori.Ortega.Share
@inject IWritableOptions<GameConfig> WritableGameConfig

<MudCard>
    <MudCardHeader>
        <CardHeaderContent><MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.EventRepeat" aria-hidden="true" /><span>@ResourceStrings.AutoJobStatus</span></MudText></CardHeaderContent>
        <CardHeaderActions><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Refresh" title="@ResourceStrings.Sync" aria-label="@ResourceStrings.Sync" /></CardHeaderActions>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        @if (!string.IsNullOrEmpty(Funcs.LastLoginError))
        {
            <MudAlert Severity="Severity.Warning">@Funcs.LastLoginError
                @if (Funcs.NextAutoLoginAttempt > DateTimeOffset.UtcNow)
                {
                    <div>@ResourceStrings.ResourceManager.GetString("RetryAt"): @ServerTime(Funcs.NextAutoLoginAttempt, "yyyy-MM-dd HH:mm:ss")</div>
                }
            </MudAlert>
        }
        @if (JobInfos.Count == 0)
        {
            <MudText Class="job-runs-empty">@(NetworkManager.PlayerId <= 0 ? ResourceStrings.PleaseLogin
                : WritableGameConfig.Value.AutoJob.DisableAll ? ResourceStrings.DisableAllJobs
                : ResourceStrings.NoScheduledJobs)</MudText>
        }
        else
        {
        <MudSimpleTable Class="job-runs-table" Dense="true" Style="overflow-x: auto;">
            <thead><tr>
                <th>@ResourceStrings.Name</th>
                <th>@ResourceStrings.NextExecutionTime</th>
                <th>@ResourceStrings.ResourceManager.GetString("LastRun")</th>
            </tr></thead>
            <tbody>
                @foreach (var job in JobInfos)
                {
                    var run = Funcs.JobRuns.GetValueOrDefault(job.Key);
                    <tr>
                        <td class="job-name">@JobName(job)</td>
                        <td class="job-next-fire">@job.NextFireTime</td>
                        <td class="job-last-run">
                            @if (run == null) { <span>—</span> }
                            else
                            {
                                <div class="job-run-status @(run.FinishedAt == null ? "is-running" : run.Cancelled ? "is-cancelled" : run.Error == null ? "is-success" : "is-error")">@(run.FinishedAt == null ? ResourceStrings.ResourceManager.GetString("TaskRunning")
                                    : run.Cancelled ? ResourceStrings.TaskCancelled
                                    : run.Error == null ? ResourceStrings.Success : ResourceStrings.ResourceManager.GetString("TaskFailed"))</div>
                                <details class="job-run-details">
                                    <summary>@ServerTime(run.StartedAt, "HH:mm:ss")</summary>
                                    <div class="job-run-time">@ResourceStrings.ResourceManager.GetString("TaskStarted"): @ServerTime(run.StartedAt, "yyyy-MM-dd HH:mm:ss")</div>
                                    @if (run.FinishedAt.HasValue)
                                    {
                                        <div class="job-run-time">@ResourceStrings.ResourceManager.GetString("TaskFinished"): @ServerTime(run.FinishedAt.Value, "yyyy-MM-dd HH:mm:ss")</div>
                                    }
                                </details>
                                @if (run.Error != null && !run.Cancelled) { <MudTooltip Text="@run.Error" RootClass="job-run-error-tip"><div class="job-run-error" aria-label="@run.Error">@run.Error</div></MudTooltip> }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<JobInfo> JobInfos = new();
    private record JobInfo(string Key, string Description, string? NextFireTime);

    // Resolve at render time: the stored description keeps the language active when the job was registered.
    private static string JobName(JobInfo job) => job.Key[(job.Key.LastIndexOf('.') + 1)..] switch
    {
        "DailyJob" => ResourceStrings.DailyJob,
        "HourlyJob" => ResourceStrings.RewardClaimJob,
        "PvpJob" => Tr("[CommonHeaderLocalPvpLabel]"),
        "LegendLeagueJob" => Tr("[CommonHeaderGlobalPvpLabel]"),
        "GuildRaidBossReleaseJob" => Tr("[GuildRaidReleaseConfirmTitle]"),
        "AutoBuyShopItemJob" => ResourceStrings.ShopAutoBuyItems,
        "LocalRaidJob" => Tr("[CommonHeaderLocalRaidLabel]"),
        "AutoChangeGachaRelicJob" => Tr("[GachaRelicChangeTitle]"),
        "AutoDrawGachaRelicJob" => ResourceStrings.Auto_draw_10_times__up_to_3_draws_,
        _ => job.Description
    };

    protected override async Task AccountChanged()
    {
        TrackAccountSubscription(Funcs.Changed.Where(change => change.PropertyName is nameof(Funcs.JobRuns) or nameof(Funcs.Logining) or nameof(Funcs.IsQuickActionExecuting))
            .Throttle(TimeSpan.FromMilliseconds(100))
            .Subscribe(change => { _ = RefreshSafely(); }));
        await Refresh();
    }

    private async Task RefreshSafely()
    {
        try { await InvokeAsync(Refresh); }
        catch (Exception e) { Logger.LogWarning(e, "Unable to refresh task status"); }
    }

    public async Task Refresh()
    {
        var funcs = Funcs;
        var userId = AccountInfo?.UserId ?? 0;
        var scheduler = await SchedulerFactory.GetScheduler();
        var triggerKeys = await scheduler.GetTriggerKeys(GroupMatcher<TriggerKey>.AnyGroup());
        var jobs = new List<JobInfo>();
        foreach (var key in triggerKeys)
        {
            var trigger = await scheduler.GetTrigger(key);
            if (trigger == null || !trigger.JobKey.Name.StartsWith($"{userId}-", StringComparison.Ordinal)) continue;
            var detail = await scheduler.GetJobDetail(trigger.JobKey);
            if (detail != null) jobs.Add(new(trigger.JobKey.Name, detail.Description ?? trigger.JobKey.Name,
                trigger.GetNextFireTimeUtc() is { } next ? ServerTime(next, "yyyy-MM-dd HH:mm:ss") : null));
        }
        if (funcs != Funcs) return;
        JobInfos = jobs;
        await InvokeAsync(StateHasChanged);
    }

    // Same clock as the cron editor and the top-bar ServerClock: game server time once logged in, local time before.
    private string ServerTime(DateTimeOffset t, string format) =>
        (Funcs?.LoginOk == true ? t.UtcDateTime + Funcs.TimeManager.DiffFromUtc : t.LocalDateTime).ToString(format);
}
