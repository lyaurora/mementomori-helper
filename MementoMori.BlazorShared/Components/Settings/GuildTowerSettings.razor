@using MementoMori.BlazorShared.Components
@using MementoMori.Ortega.Share
@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Share.Data.ApiInterface.Friend
@using MementoMori.Ortega.Share.Data.Player
@using MementoMori.Ortega.Share.Enums
@using MementoMori.Ortega.Share.Extensions

@inject IWritableOptions<PlayersOption> PlayersOptions
@inherits MementoMori.BlazorShared.Models.AccountComponent

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Filled.Castle" aria-hidden="true" /><span>@Masters.TextResourceTable.Get("[GuildTowerTitle]") <span class="panel-scope is-account"><PlayerAvatar IconId="@(Funcs?.UserSyncData?.UserStatusDtoInfo?.MainCharacterIconId ?? 0)" Name="@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name)" Size="16" />@(Funcs?.UserSyncData?.UserStatusDtoInfo?.Name)</span></span><SettingSaved @ref="_saved"/></MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="settings-form">
        <MudSwitch T="bool" Class="settings-toggle" LabelPlacement="Placement.Start" Label="@Tr("[GuildTowerEntryTitle]")" @bind-Value="_autoEntry" @bind-Value:after="Save" Color="Color.Primary"></MudSwitch>
        <MudSwitch T="bool" Class="settings-toggle" LabelPlacement="Placement.Start" Label="@Tr("[GuildTowerChallengeButton]")" @bind-Value="_autoChallenge" @bind-Value:after="Save" Color="Color.Primary"></MudSwitch>
        <MudNumericField InputMode="InputMode.numeric" T="int?" @bind-Value="_autoChallengeRetryCount" @bind-Value:after="Save" Min="0" DebounceInterval="500" Label="@ResourceStrings.Auto_challenge_retry_count" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
        <MudSwitch T="bool" Class="settings-toggle" LabelPlacement="Placement.Start" Label="@Tr("[GuildTowerJobReinforceLabel]")" @bind-Value="_autoReinforcement" @bind-Value:after="Save" Color="Color.Primary"></MudSwitch>
        <MudSwitch T="bool" Class="settings-toggle" LabelPlacement="Placement.Start" Label="@Tr("[GuildTowerStageRewardLabel]")" @bind-Value="_autoReceiveReward" @bind-Value:after="Save" Color="Color.Primary"></MudSwitch>
    </MudCardContent>
</MudCard>


@code {
    SettingSaved _saved = null!;
    bool _autoEntry;
    bool _autoChallenge;
    int? _autoChallengeRetryCount; // null while the field is empty: keep the stored count
    bool _autoReinforcement;
    bool _autoReceiveReward;


    protected override async Task AccountChanged()
    {
        var playerOpt = PlayersOptions.Value.TryGetValue(NetworkManager.PlayerId, out var saved) ? saved : new PlayerOption {PlayerId = NetworkManager.PlayerId};
        _autoEntry = playerOpt.GuildTower.AutoEntry;
        _autoChallenge = playerOpt.GuildTower.AutoChallenge;
        _autoChallengeRetryCount = playerOpt.GuildTower.AutoChallengeRetryCount;
        _autoReinforcement = playerOpt.GuildTower.AutoReinforcement;
        _autoReceiveReward = playerOpt.GuildTower.AutoReceiveReward;
    }


    private void Save() => _saved.Run(() => PlayersOptions.Update(opt =>
    {
        var playerOpt = opt.GetOrAdd(NetworkManager.PlayerId, (id) => new PlayerOption() {PlayerId = id});
        playerOpt.GuildTower.AutoEntry = _autoEntry;
        playerOpt.GuildTower.AutoChallenge = _autoChallenge;
        if (_autoChallengeRetryCount is { } retry) playerOpt.GuildTower.AutoChallengeRetryCount = retry;
        playerOpt.GuildTower.AutoReinforcement = _autoReinforcement;
        playerOpt.GuildTower.AutoReceiveReward = _autoReceiveReward;
    }));
}
