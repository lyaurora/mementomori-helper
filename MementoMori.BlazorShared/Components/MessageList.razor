@using System.Collections.ObjectModel
@using System.Reactive.Concurrency
@using System.Reactive.Linq
@using DynamicData.Binding
@using MementoMori.Funcs

@inherits MementoMori.BlazorShared.Models.AccountComponent

<div class="msg-log">
<MudSimpleTable Class="execution-messages" Elevation="0" Dense="true">
    <tbody class="d-flex flex-column-reverse">
    @foreach (var msg in _messageList)
    {
        @* One line on purpose: the cell is white-space: pre-wrap, so markup whitespace would show. *@
        <tr class="@(msg.IsError ? "is-error" : null)">
            <td><span class="msg-time">@msg.Time.ToString("HH:mm:ss")</span>@if (msg.IsError){<MudIcon Icon="@Icons.Material.Filled.Error" Class="msg-error-icon" aria-hidden="true" />}@msg.Message</td>
        </tr>
    }
    </tbody>
</MudSimpleTable>
</div>

@code {

    protected override async Task AccountChanged()
    {
        try
        {
            lock (Funcs.MesssageList) _messageList = Funcs.MesssageList.ToList();
            TrackAccountSubscription(Funcs.MesssageList.ObserveCollectionChanges().Throttle(TimeSpan.FromMilliseconds(50)).Subscribe(set =>
            {
                try
                {
                    lock (Funcs.MesssageList) _messageList = Funcs.MesssageList.ToList();
                }
                catch
                {
                    return;
                }
                InvokeAsync(StateHasChanged);
            }));
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
    // ignored
        }
        finally
        {
            @* await InvokeAsync(StateHasChanged); *@
        }
    }

    private List<LogEntry> _messageList = new();
}
