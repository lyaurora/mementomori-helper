@inherits AccountComponent
@using MementoMori.Funcs
@using MementoMori.Ortega.Common.Utils
@using MementoMori.Ortega.Custom
@using MementoMori.Ortega.Share
@using MementoMori.Ortega.Share.Data.ApiInterface.TradeShop
@using MementoMori.Ortega.Share.Data.TradeShop
@using MementoMori.Ortega.Share.Master.Data
@inject IDialogService DialogService
@if (SelectedSphere != null)
{
    <span class="shop-sphere-icon"><SphereIcon SphereMb="SelectedSphere" Size="48" /></span>
}
<MudCard Elevation="2">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText>@_itemName</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudSlider Min="1" Max="9" ValueLabel="true" @bind-Value="_buyLv">
            @Masters.TextResourceTable.Get("[EquipmentSphereSynthesisSphereLv]") @_buyLv
        </MudSlider>
        <MudSlider Min="1" Max="@Math.Max(1, MaxBuyCount)" Disabled="@(!BuyBtnEnabled)" ValueLabel="true" @bind-Value="_buyCount">
            @Masters.TextResourceTable.Get("[BulkBuyProductCartItemCountFormat]", _buyCount)
        </MudSlider>
    </MudCardContent>
    <MudCardActions>
        <MudButton Class="shop-buy-button" Variant="Variant.Filled" Color="Color.Primary" Disabled="!BuyBtnEnabled || _buying" OnClick="BuySphere">@ConsumeText</MudButton>
    </MudCardActions>
</MudCard>

@code {

    [Parameter]
    public SphereMB SphereMb { get; set; }

    [Parameter]
    public TradeShopTabInfo Tab { get; set; }

    [Parameter]
    public EventCallback OnPurchased { get; set; }

    private int _buyCount = 1;
    private int _buyLv = 1;
    private bool _buying;
    private string _itemName;

    private MementoMoriFuncs ViewModel;

    private int MaxBuyCount
    {
        get
        {
            var tradeShopSphereMb = Masters.TradeShopSphereTable.GetBySphereLevel(_buyLv);
            if (tradeShopSphereMb?.ConsumeItem1 == null || tradeShopSphereMb.ConsumeItem1.ItemCount <= 0) return 0;
            var count = tradeShopSphereMb.ConsumeItem1.ItemCount;
            var availableCount = ViewModel.UserSyncData.GetUserItemCount(tradeShopSphereMb.ConsumeItem1.ItemType, tradeShopSphereMb.ConsumeItem1.ItemId, true);
            var canBuyCount = availableCount / count;
            if (canBuyCount <= 0)
            {
                _buyCount = 1;
                return 0;
            }

            if (tradeShopSphereMb.ConsumeItem2 is { ItemCount: > 0 })
            {
                count = tradeShopSphereMb.ConsumeItem2.ItemCount;
                availableCount = ViewModel.UserSyncData.GetUserItemCount(tradeShopSphereMb.ConsumeItem2.ItemType, tradeShopSphereMb.ConsumeItem2.ItemId, true);
                canBuyCount = Math.Min(canBuyCount, availableCount / count);
            }

            var capped = (int) Math.Min(canBuyCount, int.MaxValue);
            _buyCount = Math.Clamp(_buyCount, 1, Math.Max(1, capped));
            return capped;
        }
    }

    private bool BuyBtnEnabled
    {
        get
        {
            var tradeShopSphereMb = Masters.TradeShopSphereTable.GetBySphereLevel(_buyLv);
            if (tradeShopSphereMb?.ConsumeItem1 == null) return false;
            var count = tradeShopSphereMb.ConsumeItem1.ItemCount;
            var availableCount = ViewModel.UserSyncData.GetUserItemCount(tradeShopSphereMb.ConsumeItem1.ItemType, tradeShopSphereMb.ConsumeItem1.ItemId, true);
            if (availableCount < count) return false;
            if (tradeShopSphereMb.ConsumeItem2 != null)
            {
                count = tradeShopSphereMb.ConsumeItem2.ItemCount;
                availableCount = ViewModel.UserSyncData.GetUserItemCount(tradeShopSphereMb.ConsumeItem2.ItemType, tradeShopSphereMb.ConsumeItem2.ItemId, true);
                if (availableCount < count) return false;
            }

            return true;
        }
    }

    private string ConsumeText
    {
        get
        {
            var tradeShopSphereMb = Masters.TradeShopSphereTable.GetBySphereLevel(_buyLv);
            if (tradeShopSphereMb?.ConsumeItem1 == null) return "";
            var qty = Math.Max(1, _buyCount);
            var name = ItemUtil.GetItemName(tradeShopSphereMb.ConsumeItem1);
            var count = tradeShopSphereMb.ConsumeItem1.ItemCount * qty;
            var text = $"{name} × {count}";
            if (tradeShopSphereMb.ConsumeItem2 != null)
            {
                name = ItemUtil.GetItemName(tradeShopSphereMb.ConsumeItem2);
                count = tradeShopSphereMb.ConsumeItem2.ItemCount * qty;
                text = $"{text} {name} × {count}";
            }

            return text;
        }
    }

    private SphereMB? SelectedSphere => SphereMb == null ? null : Masters.SphereTable.GetByCategoryIdAndLevel(SphereMb.CategoryId, _buyLv) ?? SphereMb;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (SphereMb != null) _itemName = Masters.TextResourceTable.Get(SphereMb.NameKey);
    }

    protected override Task AccountChanged()
    {
        ViewModel = Funcs;
        if (SphereMb != null) _itemName = Masters.TextResourceTable.Get(SphereMb.NameKey);
        return Task.CompletedTask;
    }

    private async Task BuySphere()
    {
        // set before the first await so a double click cannot stack a second confirm/purchase
        if (_buying || !BuyBtnEnabled || _buyCount < 1) return;
        var targetSphere = Masters.SphereTable.GetByCategoryIdAndLevel(SphereMb.CategoryId, _buyLv);
        if (targetSphere == null) return;
        _buying = true;
        var token = CreateAccountCancellation();
        var funcs = ViewModel;
        try
        {
            var request = new BuyItemRequest
            {
                TradeShopTabId = Tab.TradeShopTabId,
                TradeShopSphereId = targetSphere.Id,
                TradeSphereCount = _buyCount
            };
            if (await DialogService.ShowMessageBoxAsync(Masters.TextResourceTable.Get("[PurchaseConfirmationTitle]"), $"{Masters.TextResourceTable.Get("[PurchaseConfirmationMessage]")} {ResourceStrings.ConsumeItem}: {ConsumeText}",
                    Masters.TextResourceTable.Get("[CommonOkLabel]"), cancelText: Masters.TextResourceTable.Get("[CommonCancelLabel]")) != true) return;
            await funcs.GetResponse<BuyItemRequest, BuyItemResponse>(request, token);
            token.ThrowIfCancellationRequested();
            await DialogService.ShowMessageBoxAsync(Masters.TextResourceTable.Get("[PurchaseConfirmationTitle]"), Masters.TextResourceTable.Get("[ShopDialogResultSucceed]"), Masters.TextResourceTable.Get("[CommonOkLabel]"));
            await OnPurchased.InvokeAsync();
            StateHasChanged();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception e) { if (!token.IsCancellationRequested) await DialogService.ShowMessageBoxAsync(Masters.TextResourceTable.Get("[CommonErrorLabel]"), e.Message, Masters.TextResourceTable.Get("[CommonOkLabel]")); }
        finally { _buying = false; }
    }

}
