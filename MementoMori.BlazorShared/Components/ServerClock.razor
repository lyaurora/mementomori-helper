@implements IDisposable
@inject AccountSelection AccountSelection
@inject AccountManager AccountManager

@* Game server clock for the top bar; hidden until the current account has logged in (no server offset before that). *@
@if (Now() is { } now)
{
    <span class="server-clock" title="@ResourceStrings.ServerTimeLabel">
        <span class="server-clock-label">@ResourceStrings.ServerTimeLabel</span>
        <time class="server-clock-time">@now.ToString("HH:mm")<span class="server-clock-sec">@now.ToString(":ss")</span></time>
    </span>
}

@code {
    System.Threading.Timer? _timer;
    volatile bool _disposed;

    DateTime? Now()
    {
        var userId = AccountSelection.CurrentUserId;
        if (userId <= 0 || !AccountManager.TryGet(userId, out var account)) return null;
        return account.Funcs?.TimeManager.HasTimeServer == true ? account.Funcs.TimeManager.ServerNow : null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _timer = new System.Threading.Timer(_ => _ = OnTickAsync(), null,
            TimeSpan.FromMilliseconds(1000 - DateTime.UtcNow.Millisecond), TimeSpan.FromSeconds(1));
    }

    private async Task OnTickAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed) StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
    }
}
