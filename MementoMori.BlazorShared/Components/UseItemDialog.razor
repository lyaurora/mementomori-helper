@using MementoMori.Ortega.Share.Data.Item
@using MementoMori.Extensions
@using System.Text
@using MementoMori.Common.Localization
@using MementoMori.Ortega.Share

@* MudDialog root: its focus trap takes focus, keeps Tab inside and lets Esc reach the dialog.
   overflow: visible keeps the dialog itself as the scroller, so the sticky button row still pins to its bottom. *@
<MudDialog ContentClass="pa-0 ma-0" ContentStyle="overflow: visible">
    <DialogContent>
        <div class="use-item-dialog">
            <div class="use-item-summary">
                @if (Icon != null)
                {
                    <span class="use-item-icon"><img src="@Icon" @key="Icon" width="44" height="44" loading="lazy" decoding="async" alt="" onerror="this.remove()"></span>
                }
                @* Shop: Count is the buyable maximum, not an owned count, so show the cost of the chosen amount instead. *@
                <div class="use-item-name">@Name @if (CostText == null) { <span class="use-item-owned">× @Count.ToString("N0")</span> } else { <div class="use-item-owned">@CostText(_useCount)</div> }</div>
            </div>
            <MudNumericField T="long" @ref="_countField" Class="use-item-count" Label="@ButtonText" Min="1L" Max="@Count" @bind-Value="_useCount" InputMode="InputMode.numeric" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="_ => StateHasChanged()" />
            <MudSlider T="long" Class="use-item-slider" Min="1L" Max="@Count" ValueLabel="true" @bind-Value="_useCount">
                @ButtonText @_useCount
            </MudSlider>
            <pre class="use-item-result">@message</pre>
            <div class="use-item-actions">
                <MudButton OnClick="@Cancel">@Masters.TextResourceTable.Get("[CommonCloseLabel]")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@UseItem" Disabled="_processing || _buyed || _countField?.HasErrors == true || _useCount < 1 || _useCount > Count">
                    @if (_processing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                    }
                    @ButtonText
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public long Count { get; set; }

    [Parameter]
    public string ButtonText { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public Func<long, string>? CostText { get; set; }

    [Parameter]
    public Func<long, Task<IList<IUserItem>>> UseItemFunc { get; set; }

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    private string message;

    private long _useCount = 1;
    private MudNumericField<long>? _countField;

    private bool _processing;

    private bool _buyed;

    private void Cancel()
    {
        MudDialog.Close();
    }

    private async Task UseItem()
    {
        if (_processing || _buyed) return;
        if (_countField != null) await _countField.ValidateAsync();
        if (_countField?.HasErrors == true || _useCount < 1 || _useCount > Count) return;
        _processing = true;
        try
        {
            var items = await UseItemFunc(_useCount);
            _buyed = true;
            var msg = new StringBuilder();
            msg.AppendLine(string.Format(ResourceStrings.ActionSucceeded, ButtonText));
            items.PrintUserItems(s => msg.AppendLine(s));
            message = msg.ToString();
        }
        catch (Exception e) { message = e.Message; }
        finally { _processing = false; }
    }

}
