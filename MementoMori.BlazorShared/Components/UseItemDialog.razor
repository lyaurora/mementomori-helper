@using MementoMori.Ortega.Share.Data.Item
@using MementoMori.Extensions
@using System.Text
@using MementoMori.Common.Localization
@using MementoMori.Ortega.Share

<div class="use-item-dialog">
<MudCard Class="use-item-card" Elevation="0">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="12">
            <MudText Class="use-item-name">@Name <span class="use-item-owned">× @Count</span></MudText>
        </MudItem>
        <MudItem xs="12" md="12">
            <MudNumericField T="long" @ref="_countField" Class="use-item-count" Label="@ButtonText" Min="1L" Max="@Count" @bind-Value="_useCount" TextUpdateSuppression="false" Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="_ => StateHasChanged()" />
        </MudItem>
        <MudItem xs="12" md="12">
            <MudSlider T="long" Min="1L" Max="@Count" ValueLabel="true" @bind-Value="_useCount">
                @ButtonText @_useCount
            </MudSlider>
        </MudItem>
        <MudItem xs="12" md="12">
            <pre class="use-item-result">@message</pre>
        </MudItem>
        <MudItem xs="12" md="12">
            <div class="use-item-actions">
                <MudButton Variant="Variant.Outlined" OnClick="@Cancel">@Masters.TextResourceTable.Get("[CommonCloseLabel]")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@UseItem" Disabled="_processing || _buyed || _countField?.HasErrors == true || _useCount < 1 || _useCount > Count">
                    @if (_processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    }
                    <MudText Class="ms-2">@ButtonText</MudText>
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>
</MudCard>
</div>

@code {

    [Parameter]
    public string Name { get; set; }

    [Parameter]
    public long Count { get; set; }

    [Parameter]
    public string ButtonText { get; set; }

    [Parameter]
    public Func<long, Task<IList<IUserItem>>> UseItemFunc { get; set; }

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    private string message;

    private long _useCount = 1;
    private MudNumericField<long>? _countField;

    private bool _processing;

    private bool _buyed;

    private void Cancel()
    {
        MudDialog.Close();
    }

    private async Task UseItem()
    {
        if (_processing || _buyed) return;
        if (_countField != null) await _countField.Validate();
        if (_countField?.HasErrors == true || _useCount < 1 || _useCount > Count) return;
        _processing = true;
        try
        {
            var items = await UseItemFunc(_useCount);
            _buyed = true;
            var msg = new StringBuilder();
            msg.AppendLine($"{ButtonText}{ResourceStrings.Success}");
            items.PrintUserItems(s => msg.AppendLine(s));
            message = msg.ToString();
        }
        catch (Exception e) { message = e.Message; }
        finally { _processing = false; }
    }

}
