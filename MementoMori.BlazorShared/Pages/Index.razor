    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="4">
        <MudCard Class="dashboard-output">
            <MudCardHeader><MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Terminal"/><span>@ResourceStrings.ExecutionOutput</span></MudText></MudCardHeader>
            <MudCardContent>
                <MessageList/>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="4">
        <MudPaper Class="dashboard-notices">
            <MudTabs Class="notice-tabs" MinimumTabWidth="20px">
                <ChildContent>
                    <MudTabPanel Text="@Tr("[NoticeCategoryTypeEventTab]")">
                        @if (Funcs.EventInfoList != null)
                        {
                            <MudTable Class="activity-list" Elevation="0" T="NoticeInfo" Items="@Funcs.EventInfoList" Virtualize="true" Dense="true" Height="400px">
                                <RowTemplate>
                                    <MudTd>@(context.Title)</MudTd>
                                    <MudTd>
                                        <MudButton Size="Size.Small" @onclick="() => ShowNotice(context)" StartIcon="@Icons.Material.Filled.ZoomIn"/>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="@Tr("[NoticeCategoryTypeNoticeTab]")">
                        @if (Funcs.NoticeInfoList != null)
                        {
                            <MudTable Class="activity-list" Elevation="0" T="NoticeInfo" Items="@Funcs.NoticeInfoList" Virtualize="true" Dense="true" Height="400px">
                                <RowTemplate>
                                    <MudTd>@(context.Title)</MudTd>
                                    <MudTd>
                                        <MudButton Size="Size.Small" @onclick="() => ShowNotice(context)" StartIcon="@Icons.Material.Filled.ZoomIn"/>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel>
                </ChildContent>
            </MudTabs>
            <MudButton Class="dashboard-notices-sync" Size="Size.Small" Variant="Variant.Filled" @onclick="@Funcs.GetNoticeInfoList">@ResourceStrings.Sync</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="4">
        <MudCard>
            <MudCardHeader>
                <MudSwitch T="bool" Color="Color.Info" @bind-Value="@Funcs.ShowDebugInfo" Label="Debug Info"></MudSwitch>
            </MudCardHeader>
            <MudCardContent Style="max-height: 400px; overflow: scroll">
                @if (Funcs.ShowDebugInfo)
                {
                    <pre>
                 @Funcs.UserSyncData.ToJson(true)
                 </pre>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
}
</MudGrid>

@code {
    private long selectedTargetQuerstId;
    private long selectedTargetTowerLayer;
    string alertMessage = "";
    private bool _interactive;

    private List<PlayerDataInfo> playerDataInfos = new();

    protected override async Task AccountChanged()
    {
        try
        {
            alertMessage = Funcs.LoginOk ? string.Empty : ResourceStrings.PleaseLogin;
            TrackAccountSubscription(Funcs.WhenAnyPropertyChanged().Subscribe(_ => InvokeAsync(StateHasChanged)));
        }
        catch (Exception e)
        {
            alertMessage = e.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
        if (_interactive) await LoadNotices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _interactive = true; await LoadNotices(); }
    }

    private async Task LoadNotices()
    {
        var token = CreateAccountCancellation();
        try { await Funcs.GetNoticeInfoList(token); }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception e)
        {
            if (!token.IsCancellationRequested) { alertMessage = e.Message; await InvokeAsync(StateHasChanged); }
        }
    }

    private void ShowNotice(NoticeInfo context)
    {
        var options = new DialogOptions()
        {
            CloseOnEscapeKey = true
        };
        DialogService.ShowMessageBox(context.Title, (MarkupString) context.MainText, Tr("[CommonOkLabel]"));
    }

    private async Task ShowPlayerList()
    {
        playerDataInfos = await Funcs.GetPlayerDataInfo();
        var parameters = new DialogParameters<SelectPlayer>();
        parameters.Add(d => d.PlayerDataInfos, playerDataInfos);
        var dialog = await DialogService.ShowAsync<SelectPlayer>(ResourceStrings.SelectPlayer, parameters, new DialogOptions() {CloseButton = true});
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PlayerDataInfoEx playerDataInfoEx && playerDataInfoEx.PlayerDataInfo is PlayerDataInfo playerDataInfo)
        {
            await Funcs.Login(playerDataInfo, playerDataInfoEx.AutoLoginThisWorld);
        }
    }

    private static string MissionTypeName(MissionType type) => type switch
    {
        MissionType.Main => Tr("[MissionTabName1]"),
        MissionType.Daily => Tr("[MissionTabName2]"),
        MissionType.Weekly => Tr("[MissionTabName3]"),
        MissionType.Guild => Tr("[GuildMissionTitle]"),
        MissionType.GuildTower => Tr("[GuildTowerMissionTitle]"),
        MissionType.PanelSheet1 or MissionType.PanelSheet2 or MissionType.PanelSheet3 => Tr("[EventPortalBannerInsidePanelMission]"),
        _ => type.ToString()
    };

}
