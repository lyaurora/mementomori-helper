@inject IJSRuntime JsRuntime
@inject IDialogService DialogService
@inject IWritableOptions<GameConfig> GameConfig
@inject MementoMori.WebUI.UI.AtlasManager Atlas

@inherits MementoMori.BlazorShared.Models.AccountComponent
@page "/"
@using MementoMori.Ortega.Share
@using MementoMori.Ortega.Share.Data
@using MementoMori.Ortega.Share.Enums
@using MementoMori.WebUI.Extensions
@using MementoMori.BlazorShared.Components
@using ReactiveUI
@using System.Reactive.Linq
@using DynamicData.Binding
@using MementoMori.Ortega.Common.Utils
@using MementoMori.Ortega.Share.Data.Auth
@using MementoMori.Ortega.Share.Data.DtoInfo
@using MementoMori.Ortega.Share.Data.MyPage
@using MementoMori.Ortega.Share.Data.Notice
@using MementoMori.Common.Localization
@using MementoMori.Option
@using MementoMori.Ortega.Custom
@using Microsoft.Extensions.Options
@using static MementoMori.Ortega.Share.Masters
@using MementoMori.BlazorShared.Models
@using MementoMori.Ortega.Share.Master.Data

<PageTitle>@Tr("[CommonFooterHomeButtonLabel]")</PageTitle>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <MudAlert Class="mb-6" Severity="Severity.Warning">@alertMessage</MudAlert>
}
@if (AccountSelection.CurrentUserId > 0)
{
    var status = Funcs.UserSyncData?.UserStatusDtoInfo;
    var diamondIcon = Atlas.GetItemIcon(ItemType.CurrencyFree, 1);
    <div class="home-cols">
    <div class="col">
        <MudCard Class="home-hero">
            <MudCardHeader Class="justify-space-between">
                <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Badge"/><span>@ResourceStrings.CharacterInfo</span></MudText>
                <MudPaper Elevation="0" Class="d-flex justify-end gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Sync" Disabled="Funcs.Logining" @onclick="Funcs.SyncUserData">@ResourceStrings.SyncUserInfo</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Login" Disabled="Funcs.Logining" @onclick="ShowPlayerList">
                        @ResourceStrings.Login
                        @if (Funcs.Logining)
                        {
                            <MudProgressCircular Class="ml-2" Size="Size.Small" Indeterminate="true"/>
                        }
                    </MudButton>
                </MudPaper>
            </MudCardHeader>
            <MudCardContent>
                <div class="hero-who">
                    <PlayerAvatar IconId="@(status?.MainCharacterIconId ?? 0)" Name="@status?.Name" Size="76"/>
                    <div class="hero-who-text">
                        <div class="hero-name">@status?.Name</div>
                        <div class="hero-badges">
                            <span class="hero-badge is-accent" title="@Tr("[CommonPlayerRankLabel]")">@Tr("[CommonLevelFormat]", status?.Rank)</span>
                            <span class="hero-badge">@Tr("[CommonVipWithSpaceFormat]", status?.Vip)</span>
                        </div>
                    </div>
                </div>
                @{
                    var createTime = "";
                    if (Funcs.LoginOk)
                    {
                        createTime = (status?.CreateAt.ToDateTimeOffset() - NetworkManager.TimeManager.DiffFromUtc).ToString();
                    }
                }
                <div class="hero-idline">
                    <span>@Tr("[PlayerId]") @status?.PlayerId</span>
                    <span>@ResourceStrings.Account_Creation_Time @createTime</span>
                </div>
                <div class="hero-quote">@Tr("[MyPagePlayerInformationCommentLabel]") · <b>@status?.Comment</b></div>
                @{
                    var free = Funcs.UserSyncData.GetUserItemCount(ItemType.CurrencyFree, 1);
                    var paid = Funcs.UserSyncData.GetUserItemCount(ItemType.CurrencyPaid, 0);
                }
                <div class="tiles">
                    <div class="tile is-wide">
                        <span class="tile-art">@if (diamondIcon != null) {<img src="@diamondIcon" @key="diamondIcon" width="44" height="44" loading="lazy" decoding="async" alt="" onerror="this.remove()">}</span>
                        <span class="hero-tile-text"><span class="tile-label">@Tr("[ItemName4]")</span><span class="tile-value" title="@((free + paid).ToString("N0"))">@Compact(free + paid)</span></span>
                        <span class="tile-split">@Tr("[CurrencyDetailCurrencyFree]") <b title="@free.ToString("N0")">@Compact(free)</b><br>@Tr("[CurrencyDetailCurrencyPaid]") <b title="@paid.ToString("N0")">@Compact(paid)</b></span>
                    </div>
                    @Tile(ItemType.Gold, 1, Tr("[ItemName5]"))
                    @Tile(ItemType.CharacterTrainingMaterial, 1, Tr("[ItemName10]"))
                    @Tile(ItemType.CharacterTrainingMaterial, 2, Tr("[ItemName11]"))
                    @Tile(ItemType.ExchangePlaceItem, 4, Tr("[ItemName43]"))
                    @Tile(ItemType.FriendPoint, 1, Tr("[ItemName9]"))
                    @Tile(ItemType.EquipmentRarityCrystal, 1, Tr("[ItemName16]"))
                </div>
            </MudCardContent>
        </MudCard>
        <MudCard Class="home-quick">
            <MudCardHeader Class="justify-space-between">
                <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Bolt"/><span>@ResourceStrings.QuickActions</span></MudText>
                <MudPaper Elevation="0" Class="d-flex justify-end gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="!Funcs.IsQuickActionExecuting" @onclick="Funcs.CancelQuickAction">@Tr("[CommonCancelLabel]")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt" Disabled="Funcs.IsQuickActionExecuting" @onclick="Funcs.ExecuteAllQuickAction">@ResourceStrings.ExecuteAllQuick</MudButton>
                </MudPaper>
            </MudCardHeader>
            <MudCardContent>
                <MudTabs Class="quick-actions-tabs" Position="Position.Top" MinimumTabWidth="20px">
                    <MudTabPanel Text="@ResourceStrings.ExecuteAllQuick">
                        <div class="quick-action-content quick-action-list">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.GetLoginBonus">@Tr("[MyPageButtonLoginBonusLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.GetVipGift">@Tr("[VipDailyRewardLabelFormat]", Funcs.UserSyncData?.UserStatusDtoInfo?.Vip)</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.ReceiveMonthlyBoost">@Tr("[CommonMonthlyBoosterLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.GetAutoBattleReward">@Tr("[AutoBattleRewardInfoRewardLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BulkTransferFriendPoint">@Tr("[ItemName9]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.PresentReceiveItem">@Tr("[MyPagePresentBoxButtonTitle]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.ReinforcementEquipmentOneTime">@ResourceStrings.ReinforceEquipmentOnce</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BattleBossQuick">@Tr("[BattleTypeBoss]") @Tr("[GuildRaidMultipleCleanup]", 3)</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.InfiniteTowerQuick">@Tr("[CommonHeaderTowerBattleLabel]") @Tr("[GuildRaidMultipleCleanup]", 3)</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.PvpAuto">@Tr("[CommonHeaderLocalPvpLabel]") @Tr("[BattleTypeAuto]") @Tr("[CommonTimesFormat]", 5)</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.LegendLeagueAuto">@Tr("[CommonHeaderGlobalPvpLabel]") @Tr("[BattleTypeAuto]") @Tr("[CommonTimesFormat]", 10)</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BossHishSpeedBattle">@Tr("[GachaFree]") @Tr("[AutoBattleButtonQuickForward]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.FreeGacha">@Tr("[GachaFree]") @Tr("[CommonFooterGachaButtonLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.GuildCheckin">@Tr("[MissionName533]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.GuildRaid">@Tr("[CommonHeaderGuildRaidLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.OpenGuildRaid">@Tr("[GuildRaidReleaseConfirmTitle]")</MudButton>
                            @* <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.SetupLocalGvgDefense">@($"{Tr("[CommonHeaderGvgLabel]")} {ResourceStrings.Deploy_defense}")</MudButton> *@
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.ReceiveGvgReward">@($"{Tr("[CommonHeaderGvgLabel]")} {Tr("[GuildRewardTitle]")}")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoLocalRaid">@Tr("[CommonHeaderLocalRaidLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoGuildTower">@Tr("[GuildTowerTitle]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BountyQuestRewardAuto">@Tr("[CommonHeaderBountyQuestLabel]") @Tr("[BountyQuestAllReceive]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BountyQuestStartAuto">@Tr("[CommonHeaderBountyQuestLabel]") @Tr("[BountyQuestAutoPlacement]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoBuyShopItem">@ResourceStrings.ShopAutoBuyItems</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoUseItems">@ResourceStrings.UseNormalItems</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoRankUpCharacter">@Tr("[CharacterRankUpBulkButton]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.ReadAllMemories">@Tr("[CharacterDetailMemory]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.ReceiveAchievementReward">@Tr("[AchieveRankingAchievementTargetLabel]")</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.UseFriendCode">@Tr("[InputFriendCodeEnabled]")</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@Tr("[ItemBoxButtonBulkCasting]")">
                        <div class="quick-action-content quick-action-list">
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoEquipmentMatchlessInheritance">@ResourceStrings.AutoMatchlessInheritance</MudButton>
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoEquipmentLegendInheritance">@ResourceStrings.AutoLegendInheritance</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@Tr("[PlayerRankingTypeStage]")">
                        <div class="quick-action-content quick-action-form">
                            <MudSelect T="long" @bind-Value="@selectedTargetQuerstId" Label="@ResourceStrings.StopAfterSpecifiedStage" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="long" Value="0">@ResourceStrings.NoStop</MudSelectItem>
                                @foreach (var quest in QuestTable.GetArray().Where(d => d.BaseBattlePower > 0 && d.Id > Funcs.UserSyncData.UserBattleBossDtoInfo?.BossClearMaxQuestId).Take(50))
                                {
                                    <MudSelectItem T="long" Value="quest.Id">@quest.Memo</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" OnClick="() => Funcs.AutoBossRequest(selectedTargetQuerstId)">@Tr("[BattleTypeBoss]") @Tr("[BattleTypeAuto]")</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@Tr("[CommonHeaderDungeonBattleLabel]")">
                        <div class="quick-action-content quick-action-list">
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.AutoDungeonBattle">@Tr("[CommonHeaderDungeonBattleLabel]") @Tr("[BattleTypeAuto]")</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@Tr("[CommonHeaderTowerBattleLabel]")">
                        <div class="quick-action-content quick-action-form">
                            <MudSelect T="TowerType" Label="@ResourceStrings.TowerType" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="@Funcs.SelectedAutoTowerType">
                                @foreach (var type in Funcs.GetAvailableTower())
                                {
                                    <MudSelectItem T="TowerType" Value="@type">@(Tr(type))</MudSelectItem>
                                }
                            </MudSelect>
                            @if (Funcs.SelectedAutoTowerType != TowerType.None)
                            {
                                var maxTowerBattleId = Funcs.UserSyncData.UserTowerBattleDtoInfos.ToList().Find(x => x.TowerType == Funcs.SelectedAutoTowerType).MaxTowerBattleId;
                                var quests = TowerBattleQuestTable.GetArray().Where(d => d.TowerType == Funcs.SelectedAutoTowerType && d.Floor > maxTowerBattleId).Take(50);
                                <MudSelect @bind-Value="selectedTargetTowerLayer" Label="@ResourceStrings.StopAfterSpecifiedStage" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="long" Value="0">@ResourceStrings.NoStop</MudSelectItem>
                                    @foreach (var layer in quests)
                                    {
                                        <MudSelectItem T="long" Value="layer.Floor">@layer.Floor</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" OnClick="() => Funcs.AutoInfiniteTowerRequest(selectedTargetTowerLayer)">@Tr("[CommonHeaderTowerBattleLabel]") @Tr("[BattleTypeAuto]")</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@Tr("[CommonForgedLabel]")">
                        <div class="quick-action-content"><EquipmentTraining /></div>
                    </MudTabPanel>
                    <MudTabPanel Text="Debug">
                        <div class="quick-action-content quick-action-list">
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.Debug">Debug</MudButton>
                            <MudButton Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.LogDebug">LogTest</MudButton>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </MudCardContent>
        </MudCard>
        <MudCard Class="home-debug">
            <MudCardHeader>
                <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@Funcs.ShowDebugInfo" Label="@ResourceStrings.DebugInfo"></MudSwitch>
            </MudCardHeader>
            @if (Funcs.ShowDebugInfo)
            {
                <MudCardContent Style="max-height: 400px; overflow: auto">
                    <pre>@Funcs.UserSyncData.ToJson(true)</pre>
                </MudCardContent>
            }
        </MudCard>
    </div>
    <div class="col">
        <MudCard Class="home-entries">
            <MudCardHeader Class="justify-space-between">
                <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Home"/><span>@Tr("[CommonFooterHomeButtonLabel]")</span></MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" @onclick="Funcs.GetMyPage" StartIcon="@Icons.Material.Filled.Sync">@ResourceStrings.Sync</MudButton>
            </MudCardHeader>
            <MudCardContent>
                <div class="entries">
                    @Entry(Atlas.GetItemIcon(ItemType.FriendPoint, 1), 0, Funcs.Mypage?.ExistNewFriendPointTransfer ?? false, Tr("[ItemName9]"))
                    @Entry(Atlas.GetMypageIcon(16), 16, Funcs.Mypage?.ExistNewPrivateChat ?? false, Tr("[CommonHeaderChatLabel]"))
                    @Entry(Atlas.GetMypageIcon(21), 21, Funcs.Mypage?.ExistNotReceivedBountyQuestReward ?? false, Tr("[CommonHeaderBountyQuestLabel]"))
                    @Entry(Atlas.GetMypageIcon(1), 1, Funcs.Mypage?.ExistNotReceivedMissionReward ?? false, Tr("[MyPageMenuButtonMissionLabel]"))
                    @Entry(Atlas.GetMypageIcon(13), 13, Funcs.IsNotClearDungeonBattleMap, Tr("[CommonHeaderDungeonBattleLabel]"))
                    @Entry(Atlas.GetMypageIcon(4), 4, Funcs.UserSyncData?.PresentCount > 0, Tr("[MyPageMenuButtonPresentBoxLabel]"))
                    @foreach (var info in Funcs.Mypage?.MypageInfo?.MypageIconInfos ?? new List<MypageIconInfo>())
                    {
                        @Entry(Atlas.GetMypageIcon(info.ImageId), info.ImageId, info.IsDisplayBadge, (MarkupString)Tr(info.IconNameKey))
                    }
                </div>
                <MudDivider Class="my-4"/>
                <div class="bq-head">
                    <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Explore"/><span>@Tr("[CommonHeaderBountyQuestLabel]")</span></MudText>
                    @if (GameConfig.Value.BountyQuestAuto.TargetItems.Count > 0)
                    {
                        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="@Funcs.BountyRequestForceAll" Label="@ResourceStrings.ForceDispatch"></MudSwitch>
                    }
                </div>
                <div class="bq-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BountyQuestRewardAuto">@Tr("[BountyQuestAllReceive]")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="@Funcs.BountyQuestStartAuto">@Tr("[BountyQuestAutoPlacement]")</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@Funcs.IsQuickActionExecuting" @onclick="RemakeBounty">
                        <span class="bq-cost">@if (diamondIcon != null) {<img src="@diamondIcon" @key="diamondIcon" width="18" height="18" loading="lazy" decoding="async" alt="" onerror="this.remove()">}</span>
                        @Tr("[CommonAlternativesItemFormat]", Tr("[CommonCurrencyName]"), 20)
                    </MudButton>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Sync" title="@ResourceStrings.Sync" aria-label="@ResourceStrings.Sync" @onclick="Funcs.GetBountyRequestInfo"/>
                </div>
                <div class="bq-list">
                    @foreach (var info in Funcs.BountyQuestResponseInfo?.UserBountyQuestDtoInfos ?? new List<UserBountyQuestDtoInfo>())
                    {
                        var bountyQuestInfo = Funcs.BountyQuestResponseInfo.BountyQuestInfos?.Find(d => d.BountyQuestId == info.BountyQuestId);
                        if (bountyQuestInfo == null) continue;
                        var guerrilla = bountyQuestInfo.BountyQuestType == BountyQuestType.Guerrilla;
                        var itemNames = guerrilla
                            ? Tr("[ItemRewardDetailDialogLotteryRateLabel]")
                            : string.Join(",", (bountyQuestInfo.RewardItems ?? []).Select(d => $"{ItemUtil.GetItemName(d)}×{d.ItemCount}"));
                        var reward = guerrilla ? null : bountyQuestInfo.RewardItems?.FirstOrDefault();
                        var rewardIcon = reward == null ? null : Atlas.GetItemIcon(reward.ItemType, reward.ItemId);
                        string? statusLabel = ResourceStrings.NotStarted;
                        string? time = null;
                        var statusClass = "";
                        if (info.BountyQuestEndTime > 0)
                        {
                            var nowMilli = DateTimeOffset.Now.Add(Funcs.TimeManager.DiffFromUtc).ToUnixTimeMilliseconds();
                            if (nowMilli < info.BountyQuestEndTime)
                            {
                                statusLabel = ResourceStrings.OnGoing;
                                time = TimeSpan.FromMilliseconds(info.BountyQuestEndTime - nowMilli).ToString(@"hh\:mm\:ss");
                                statusClass = "is-running";
                            }
                            else if (!info.IsReward)
                            {
                                statusLabel = ResourceStrings.NotReceived;
                                time = TimeSpan.FromMilliseconds(info.RewardEndTime - nowMilli).ToString(@"hh\:mm\:ss");
                                statusClass = "is-todo";
                            }
                            else
                            {
                                statusLabel = ResourceStrings.Received;
                            }
                        }
                        <div class="bq-row" title="@Tr(bountyQuestInfo.BountyQuestNameKey)">
                            <span class="bq-rarity is-@bountyQuestInfo.BountyQuestRarity.ToString().ToLowerInvariant()">@Tr(bountyQuestInfo.BountyQuestRarity)</span>
                            <span class="bq-art">
                                @if (guerrilla)
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small"/>
                                }
                                else if (rewardIcon != null)
                                {
                                    <img src="@rewardIcon" @key="rewardIcon" width="28" height="28" loading="lazy" decoding="async" alt="" onerror="this.remove()">
                                }
                            </span>
                            <span class="bq-name">@itemNames</span>
                            <span class="bq-status @statusClass">
                                @if (statusClass == "is-running")
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" title="@statusLabel" aria-label="@statusLabel"/>
                                }
                                else
                                {
                                    <span>@statusLabel</span>
                                }
                                @if (time != null)
                                {
                                    <span class="bq-time">@time</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </MudCardContent>
        </MudCard>
        <GrowthCard/>
        <MudCard Class="dashboard-output">
            <MudCardHeader><MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Terminal"/><span>@ResourceStrings.ExecutionOutput</span></MudText></MudCardHeader>
            <MudCardContent>
                <MessageList/>
            </MudCardContent>
        </MudCard>
    </div>
    <div class="col">
        <MudCard Class="home-missions">
            <MudCardHeader Class="justify-space-between">
                <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.TaskAlt"/><span>@Tr("[MyPageMenuButtonMissionLabel]")</span></MudText>
                <MudPaper Elevation="0" Class="d-flex justify-end gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Sync" @onclick="@Funcs.GetMissionInfo">@ResourceStrings.Sync</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" @onclick="@Funcs.RewardMissonActivity">@ResourceStrings.RewardMissonActivity</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" @onclick="@Funcs.CompleteMissions">@Tr("[MissionAllReceiveButton]")</MudButton>
                </MudPaper>
            </MudCardHeader>
            <MudCardContent>
                @{ var missionGroups = MissionGroups(); }
                @if (missionGroups.Count > 0)
                {
                    <MudTabs Class="mission-tabs" MinimumTabWidth="20px">
                        @foreach (var (group, rows) in missionGroups)
                        {
                            var done = rows.Count(r => r.Done);
                            <MudTabPanel Text="@MissionGroupName(group)">
                                <div class="mission-progress">
                                    <span class="mission-progress-count"><b>@done</b> / @rows.Count @ResourceStrings.Finished</span>
                                    <MudProgressLinear Color="Color.Primary" Rounded="true" Value="@(done * 100.0 / rows.Count)" aria-label="@($"{done} / {rows.Count} {ResourceStrings.Finished}")"/>
                                </div>
                                @foreach (var row in rows)
                                {
                                    <div class="mission-row @(row.Done ? "is-done" : null)">
                                        <span class="mission-check">@if (row.Done) {<MudIcon Icon="@Icons.Material.Filled.Check"/>}</span>
                                        <span class="mission-name">@Tr(row.Mb.NameKey)</span>
                                        <span class="mission-status @(row.Todo ? "is-todo" : null)">@row.Status</span>
                                    </div>
                                }
                            </MudTabPanel>
                        }
                    </MudTabs>
                }
            </MudCardContent>
        </MudCard>
        <MudCard Class="home-notices">
            <MudCardContent>
                <MudTabs Class="notice-tabs" MinimumTabWidth="20px" HeaderPosition="TabHeaderPosition.After">
                    <Header>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Sync" @onclick="@Funcs.GetNoticeInfoList">@ResourceStrings.Sync</MudButton>
                    </Header>
                    <ChildContent>
                        <MudTabPanel Text="@Tr("[NoticeCategoryTypeEventTab]")">@NoticeList(Funcs.EventInfoList)</MudTabPanel>
                        <MudTabPanel Text="@Tr("[NoticeCategoryTypeNoticeTab]")">@NoticeList(Funcs.NoticeInfoList)</MudTabPanel>
                    </ChildContent>
                </MudTabs>
            </MudCardContent>
        </MudCard>
    </div>
    </div>
}

@code {
    private long selectedTargetQuerstId;
    private long selectedTargetTowerLayer;
    string alertMessage = "";
    private bool _interactive;

    private List<PlayerDataInfo> playerDataInfos = new();

    protected override async Task AccountChanged()
    {
        selectedTargetQuerstId = 0;
        selectedTargetTowerLayer = 0;
        try
        {
            alertMessage = Funcs.LoginOk ? string.Empty : ResourceStrings.PleaseLogin;
            // Sample, not Throttle: Throttle starves while a job keeps changing properties; Sample renders the latest state at most 4x/s.
            TrackAccountSubscription(Funcs.WhenAnyPropertyChanged().Sample(TimeSpan.FromMilliseconds(250)).Subscribe(_ => InvokeAsync(StateHasChanged)));
        }
        catch (Exception e)
        {
            alertMessage = e.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
        // Don't block the account-switch queue on network I/O; LoadNotices is account-scoped and catches everything.
        if (_interactive) _ = LoadNotices();
    }

    // Paid action: drop clicks while another action runs instead of queueing a second 20-diamond remake.
    private Task RemakeBounty() => Funcs.IsQuickActionExecuting ? Task.CompletedTask : Funcs.RemakeBountyRequest();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _interactive = true; await LoadNotices(); }
    }

    private async Task LoadNotices()
    {
        var token = CreateAccountCancellation();
        try { await Funcs.GetNoticeInfoList(token); }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception e)
        {
            if (!token.IsCancellationRequested) { alertMessage = e.Message; await InvokeAsync(StateHasChanged); }
        }
    }

    private void ShowNotice(NoticeInfo context)
    {
        var options = new DialogOptions()
        {
            CloseOnEscapeKey = true
        };
        DialogService.ShowMessageBox(context.Title, (MarkupString) context.MainText, Tr("[CommonOkLabel]"));
    }

    private async Task ShowPlayerList()
    {
        var funcs = Funcs; // the selected account may change while the dialog is open
        playerDataInfos = await funcs.GetPlayerDataInfo();
        var parameters = new DialogParameters<SelectPlayer>();
        parameters.Add(d => d.PlayerDataInfos, playerDataInfos);
        var dialog = await DialogService.ShowAsync<SelectPlayer>(ResourceStrings.SelectPlayer, parameters, new DialogOptions() {CloseButton = true});
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PlayerDataInfoEx playerDataInfoEx && playerDataInfoEx.PlayerDataInfo is PlayerDataInfo playerDataInfo)
        {
            await funcs.Login(playerDataInfo, playerDataInfoEx.AutoLoginThisWorld);
        }
    }

    private sealed record MissionLine(MissionMB Mb, string Status, bool Done, bool Todo);

    // Mission row to show: latest id of the first non-empty status bucket. Groups may lack buckets and ids may be missing from the master (row skipped).
    private static MissionLine? MissionRow(UserMissionDtoInfo m)
    {
        long? Last(MissionStatusType t) => m.MissionStatusHistory != null && m.MissionStatusHistory.TryGetValue(t, out var l) && l.Count > 0 ? l[^1] : null;
        MissionLine? Line(long id, Func<MissionMB, string> status, bool done, bool todo) => MissionTable.GetById(id) is { } mb ? new MissionLine(mb, status(mb), done, todo) : null;
        if (Last(MissionStatusType.Progress) is { } progress) return Line(progress, mb => $"{m.ProgressCount}/{mb.RequireValue}", false, true);
        if (Last(MissionStatusType.NotReceived) is { } notReceived) return Line(notReceived, _ => ResourceStrings.NotReceived, true, true);
        if (Last(MissionStatusType.Locked) is { } locked) return Line(locked, _ => ResourceStrings.NotUnlocked, false, false);
        if (m.MissionType is MissionType.Daily or MissionType.Weekly && Last(MissionStatusType.Received) is { } received) return Line(received, _ => ResourceStrings.Finished, true, false);
        return null;
    }

    private static readonly MissionGroupType[] MissionGroupOrder = [MissionGroupType.Daily, MissionGroupType.Weekly, MissionGroupType.Main, MissionGroupType.Guild, MissionGroupType.GuildTower, MissionGroupType.Panel];

    // One tab per loaded group: fixed order first, then the rest in enum order; groups with nothing to show are left out.
    private List<(MissionGroupType Group, List<MissionLine> Rows)> MissionGroups() =>
        (Funcs.MissionInfoDict ?? [])
        .OrderBy(p => Array.IndexOf(MissionGroupOrder, p.Key) is var i and >= 0 ? i : MissionGroupOrder.Length + (int) p.Key)
        .Select(p => (p.Key, (p.Value?.UserMissionDtoInfoDict?.Values ?? Enumerable.Empty<List<UserMissionDtoInfo>>())
            .SelectMany(x => x ?? []).Select(MissionRow).OfType<MissionLine>().ToList()))
        .Where(g => g.Item2.Count > 0)
        .ToList();

    private string MissionGroupName(MissionGroupType group) => group switch
    {
        MissionGroupType.Main => Tr("[MissionTabName1]"),
        MissionGroupType.Daily => Tr("[MissionTabName2]"),
        MissionGroupType.Weekly => Tr("[MissionTabName3]"),
        MissionGroupType.Guild => Tr("[GuildMissionTitle]"),
        MissionGroupType.GuildTower => Tr("[GuildTowerMissionTitle]"),
        MissionGroupType.Panel => Tr("[EventPortalBannerInsidePanelMission]"),
        MissionGroupType.Beginner => Tr("[BeginnerMissionTitle]"),
        MissionGroupType.Comeback => Tr("[ComebackMissionTitle]"),
        MissionGroupType.PopularityVote => Tr("[PopularityVoteMissionTitle]"),
        MissionGroupType.BookSort => Tr("[BookSortMissionTitle]"),
        MissionGroupType.RentalRaid => Tr("[RentalRaidMissionTitle]"),
        // Event/collab titles change per event: prefer the live MyPage button name, fall back to the generic game label.
        MissionGroupType.Limited => IconName(TransferSpotType.EventMission) ?? Tr("[LimitedMissionTitle]"),
        MissionGroupType.Collab => IconName(TransferSpotType.CollabMission) ?? Tr("[MyPageButtonCollabMissionLabel2]").Replace("<br>", " "),
        MissionGroupType.NewCharacter => IconName(TransferSpotType.NewCharacterMission) ?? Tr("[MyPageButtonNewCharacterMissionLabel]").Replace("<br>", " "),
        _ => group.ToString()
    };

    private string? IconName(TransferSpotType spot) =>
        Funcs.Mypage?.MypageInfo?.MypageIconInfos?.FirstOrDefault(i => i.TransferDetailInfo?.TransferSpotType == spot) is { } icon
            ? Tr(icon.IconNameKey).Replace("<br>", " ") : null;

    private RenderFragment Tile(ItemType type, long id, string label) => __builder =>
    {
        var icon = Atlas.GetItemIcon(type, id);
        var count = Funcs.UserSyncData.GetUserItemCount(type, id);
        <div class="tile">
            <span class="tile-art">@if (icon != null) {<img src="@icon" @key="icon" width="36" height="36" loading="lazy" decoding="async" alt="" onerror="this.remove()">}</span>
            <span class="hero-tile-text"><span class="tile-label">@label</span><span class="tile-value" title="@count.ToString("N0")">@Compact(count)</span></span>
        </div>
    };

    // MyPage entry: game icon in a fixed box, red dot inside that box. Name may be game markup (<br>).
    // MYPAGE_ICON sprites carry uneven transparent margins (most sit high in the 128px canvas); shift by the
    // opaque-bbox offset, in % of the icon, so the art is optically centred in its box.
    // ponytail: measured for the icons seen on a real account; unknown ids stay geometric-centred, add them here if one looks off.
    private static readonly Dictionary<long, (double X, double Y)> EntryNudge = new()
    {
        [1] = (-1.6, 2.7), [4] = (0.8, 7.4), [5] = (-7.4, 2), [6] = (0, 5.9), [13] = (-2, 14.5),
        [16] = (0.4, 11.7), [20] = (0, 14.1), [21] = (-0.4, 10.2), [39] = (-0.8, 11.3),
    };

    private RenderFragment Entry(string? icon, long mypageId, bool dot, object name) => __builder =>
    {
        var nudge = EntryNudge.TryGetValue(mypageId, out var n) ? FormattableString.Invariant($"transform:translate({n.X}%,{n.Y}%)") : null;
        <div class="entry">
            <span class="entry-art">
                @if (icon != null) {<img src="@icon" @key="icon" style="@nudge" width="44" height="44" loading="lazy" decoding="async" alt="" onerror="this.remove()">}
                @if (dot) {<span class="entry-dot"></span>}
            </span>
            @{ var label = name.ToString()?.Replace("<br>", " ") ?? ""; }
            <span title="@System.Text.RegularExpressions.Regex.Replace(label, "<[^>]*>", "")">@(name is MarkupString ? (MarkupString)label : label)</span>
        </div>
    };

    private RenderFragment NoticeList(IEnumerable<NoticeInfo>? notices) => __builder =>
    {
        foreach (var notice in notices ?? [])
        {
            <button type="button" class="notice-row" @onclick="() => ShowNotice(notice)"><span>@notice.Title</span><MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"/></button>
        }
    };

}
