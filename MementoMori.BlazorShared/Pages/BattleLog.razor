@page "/battlelog"
@using MementoMori.Option
@using MementoMori.Common.Localization
@using MementoMori.Ortega.Share.Data.Battle.Result
@using MementoMori.Ortega.Share.Enums
@inject IWritableOptions<GameConfig> GameConfig
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IFileSaver FileSaver

<PageTitle>@MementoMori.Ortega.Share.Masters.TextResourceTable.Get("[BattleReportTitle]")</PageTitle>

<div class="battle-log-page">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="5" lg="4">
            <MudCard Class="battle-log-card">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Class="panel-title">
                            <MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Assessment" aria-hidden="true" />
                            <span>@ResourceStrings.BattleRecent</span>
                        </MudText>
                        <MudText Typo="Typo.caption" Class="battle-log-muted">
                            @string.Format(ResourceStrings.BattleCounts, VisibleEntries.Count, VisibleEntries.Count(e => e.Win), VisibleEntries.Count(e => !e.Win))
                        </MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <div class="battle-log-detail-actions">
                            <MudTooltip Text="@ResourceStrings.Sync">
                                <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" aria-label="@ResourceStrings.Sync" OnClick="ReloadLogs" />
                            </MudTooltip>
                            <MudMenu Icon="@Icons.Material.Rounded.DeleteSweep" Size="Size.Small" Dense="true" AriaLabel="@ResourceStrings.BattleLogCleanRange">
                                <MudMenuItem OnClick="() => CleanBattleLogs(1)">@ResourceStrings.BattleLogCleanOption1Day</MudMenuItem>
                                <MudMenuItem OnClick="() => CleanBattleLogs(7)">@ResourceStrings.BattleLogCleanOption1Week</MudMenuItem>
                                <MudMenuItem OnClick="() => CleanBattleLogs(30)">@ResourceStrings.BattleLogCleanOption1Month</MudMenuItem>
                                <MudMenuItem OnClick="() => CleanBattleLogs(0)">@ResourceStrings.BattleLogCleanOptionAll</MudMenuItem>
                            </MudMenu>
                        </div>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    @if (_presentTypes.Count > 1)
                    {
                        <div class="battle-log-filters" role="group" aria-label="@ResourceStrings.BattleLogType">
                            <button type="button" class="app-choice" aria-pressed="@(_filterType == null ? "true" : "false")" @onclick="() => SetFilter(null)">
                                @ResourceStrings.GrowthFilterAll
                            </button>
                            @foreach (var type in _presentTypes)
                            {
                                var t = type;
                                <button type="button" class="app-choice" aria-pressed="@(_filterType == t ? "true" : "false")" @onclick="() => SetFilter(t)">
                                    @BattleLogTypeName(t)
                                </button>
                            }
                        </div>
                    }

                    @if (VisibleEntries.Count == 0)
                    {
                        <MudText Class="battle-log-empty" Align="Align.Center">@ResourceStrings.BattleEmpty</MudText>
                    }
                    else
                    {
                        <div class="battle-log-list" role="listbox" aria-label="@ResourceStrings.BattleLogFile">
                            @foreach (var entry in VisibleEntries.Take(300))
                            {
                                var e = entry;
                                var selected = ReferenceEquals(e, _selectedEntry);
                                <button type="button" class="battle-log-row @(selected ? "is-selected" : null)" role="option" aria-selected="@(selected ? "true" : "false")" @onclick="() => SelectEntry(e)">
                                    <MudIcon Icon="@(e.Win ? Icons.Material.Rounded.EmojiEvents : Icons.Material.Rounded.Close)" Color="@(e.Win ? Color.Success : Color.Error)" Size="Size.Small" aria-hidden="true" />
                                    <span class="battle-log-row-main">
                                        <span class="battle-log-row-title">@e.KindLabel · @e.Target</span>
                                        @* BattleTime.StartBattle is server-local wall clock encoded as Unix ms. *@
                                        <time class="battle-log-row-time" datetime="@e.Time.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss")">@e.Time.UtcDateTime.ToString("MM/dd HH:mm")</time>
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="7" lg="8">
            @if (_selectedEntry == null)
            {
                <MudCard Class="battle-log-card battle-log-placeholder">
                    <MudCardContent>
                        <MudText Class="battle-log-empty" Align="Align.Center">
                            @(_entries.Count == 0 ? ResourceStrings.BattleEmpty : ResourceStrings.BattlePick)
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }
            else if (_selectedResult?.SimulationResult == null)
            {
                <MudCard Class="battle-log-card">
                    <MudCardContent>
                        <MudAlert Severity="Severity.Warning">@(_parseError ?? ResourceStrings.BattleEmpty)</MudAlert>
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                var sim = _selectedResult.SimulationResult;
                var endInfo = sim.BattleEndInfo;
                var win = endInfo?.IsWinAttacker() ?? _selectedEntry.Win;
                var reports = sim.BattleCharacterReports ?? [];
                var maxDmg = reports.Count > 0 ? Math.Max(1L, reports.Max(r => r.TotalGiveDamage)) : 1L;
                <MudCard Class="battle-log-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="battle-log-detail-heading">
                                <span class="@(win ? "is-win" : "is-lose")">@(win ? ResourceStrings.BattleVictory : ResourceStrings.BattleDefeat)</span>
                                <span class="battle-log-muted"> · @_selectedEntry.KindLabel · @_selectedEntry.Target</span>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="battle-log-muted battle-log-detail-meta">
                                @_selectedEntry.Time.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")
                                @if (endInfo != null)
                                {
                                    @(" · ")@string.Format(ResourceStrings.BattleEndedOnTurn, endInfo.EndTurn)@(endInfo.IsOutOfTurn ? $" ({ResourceStrings.BattleOutOfTurns})" : "")
                                }
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <div class="battle-log-detail-actions">
                                <MudButton Size="Size.Small" Variant="@(_showReplay ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlayCircle" OnClick="ToggleReplay">
                                    @ResourceStrings.BattleReplay
                                </MudButton>
                                <MudTooltip Text="@Tr("[LamentDownloadButton]")">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Download" Size="Size.Small" aria-label="@Tr("[LamentDownloadButton]")" OnClick="() => DownloadBattleLog(_selectedEntry.FileName)" />
                                </MudTooltip>
                            </div>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="pt-0">
                        @if (reports.Count == 0)
                        {
                            <MudText Class="battle-log-empty" Align="Align.Center">
                                @ResourceStrings.You_can_download_the_battle_log_and_parse_it_here:
                                <MudLink Href="@GameConfig.Value.BattleLogViewerUrl" Target="_blank" Typo="Typo.body2">@ResourceStrings.BattleLogViewerTitle</MudLink>
                            </MudText>
                        }
                        else
                        {
                            @foreach (var side in new[] { BattleFieldCharacterGroupType.Attacker, BattleFieldCharacterGroupType.Receiver })
                            {
                                var team = GetSideReports(sim, side);
                                if (team.Count == 0) continue;
                                <MudText Typo="Typo.subtitle2" Class="battle-log-side-title">
                                    @(side == BattleFieldCharacterGroupType.Attacker ? ResourceStrings.BattleYourTeam : ResourceStrings.BattleEnemy)
                                    <span class="battle-log-muted"> · @string.Format(ResourceStrings.BattleAliveDamage, team.Count(r => r.Hp > 0), team.Count, FormatShortNumber(team.Sum(r => r.TotalGiveDamage)))</span>
                                </MudText>
                                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="battle-log-table">
                                    <thead>
                                        <tr>
                                            <th>@ResourceStrings.BattleUnit</th>
                                            <th>@ResourceStrings.BattleDamageDealt</th>
                                            <th class="battle-log-num">@ResourceStrings.BattleTaken</th>
                                            <th class="battle-log-num">@ResourceStrings.BattleHealed</th>
                                            <th class="battle-log-num">@ResourceStrings.BattleHpLeft</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in team)
                                        {
                                            var hpPct = r.MaxHp > 0 ? Math.Clamp((double)r.Hp / r.MaxHp * 100d, 0d, 100d) : 0d;
                                            <tr class="@(r.Hp <= 0 ? "is-dead" : null)">
                                                <td>
                                                    <div class="battle-log-unit-name">@GetUnitName(r)</div>
                                                    <div class="battle-log-unit-sub">Lv @r.CharacterLevel · @Tr(r.ElementType)@(string.IsNullOrEmpty(r.PlayerName) ? "" : $" · {r.PlayerName}")</div>
                                                </td>
                                                <td class="battle-log-dmg-cell">
                                                    <div class="battle-log-num">@FormatShortNumber(r.TotalGiveDamage)</div>
                                                    <MudProgressLinear Value="@((double)r.TotalGiveDamage / maxDmg * 100d)" Color="@(side == BattleFieldCharacterGroupType.Attacker ? Color.Primary : Color.Error)" Rounded="true" Size="Size.Small" />
                                                </td>
                                                <td class="battle-log-num">@FormatShortNumber(r.TotalReceiveDamage)</td>
                                                <td class="battle-log-num">@FormatShortNumber(r.TotalHpRecovery)</td>
                                                <td class="battle-log-num">@(r.Hp <= 0 ? ResourceStrings.BattleDead : $"{hpPct:0}%")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        }
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>

        @if (_showReplay && _selectedResult != null)
        {
            <MudItem xs="12">
                <div class="battle-log-frame">
                    <div class="battle-log-replay-bar">
                        <MudText Typo="Typo.caption" Class="battle-log-muted">
                            @ResourceStrings.BattleLogViewerTitle:
                            <MudLink Href="@GameConfig.Value.BattleLogViewerUrl" Target="_blank" rel="noopener noreferrer" Typo="Typo.caption">@GameConfig.Value.BattleLogViewerUrl</MudLink>
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" aria-label="@ResourceStrings.Cancel" OnClick="ToggleReplay" />
                    </div>
                    <iframe id="log_viewer" class="battle-log-viewer" title="@ResourceStrings.BattleLogViewerTitle" src="@GameConfig.Value.BattleLogViewerUrl"></iframe>
                </div>
            </MudItem>
        }
    </MudGrid>
</div>
