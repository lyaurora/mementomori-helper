@using MementoMori.Option
@using MementoMori.Common.Localization
@inject IWritableOptions<GameConfig> GameConfig
@page "/battlelog"
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IFileSaver FileSaver

<div class="battle-log-page">
<MudText Class="battle-log-intro" Typo="Typo.body1">
    @ResourceStrings.You_can_download_the_battle_log_and_parse_it_here: <MudLink Href="@GameConfig.Value.BattleLogViewerUrl" Target="_blank">Battle Log Viewer</MudLink>
</MudText>

<div class="battle-log-controls">
<div class="battle-log-cleanup">
    <MudSelect Class="battle-log-clean-range" @bind-Value="_selectedCleanRange" Label="@ResourceStrings.BattleLogCleanRange" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="1">@ResourceStrings.BattleLogCleanOption1Day</MudSelectItem>
        <MudSelectItem Value="7">@ResourceStrings.BattleLogCleanOption1Week</MudSelectItem>
        <MudSelectItem Value="30">@ResourceStrings.BattleLogCleanOption1Month</MudSelectItem>
        <MudSelectItem Value="0">@ResourceStrings.BattleLogCleanOptionAll</MudSelectItem>
    </MudSelect>
    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Variant="Variant.Outlined" title="@ResourceStrings.BattleLogCleanRange" aria-label="@ResourceStrings.BattleLogCleanRange"
                   OnClick="CleanBattleLogs" Color="Color.Error"></MudIconButton>
</div>

<div role="group" class="battle-log-toolbar">
    <MudIconButton Icon="@Icons.Material.Filled.Pageview" Size="Size.Small" Variant="Variant.Outlined" title="Battle Log Viewer" aria-label="Battle Log Viewer" OnClick="() => ViewBattleLog(SelectedBattleResult)"></MudIconButton>
    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Variant="Variant.Outlined" title="Log file" aria-label="Log file" OnClick="() => DownloadBattleLog(SelectedBattleResult)"></MudIconButton>
    <MudSelect Class="battle-log-type" Label="Battle Type" T="BattleLogType" @bind-Value="selectedBattleLogType" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (BattleLogType battleLogType in Enum.GetValues(typeof(BattleLogType)))
        {
            <MudSelectItem Value="battleLogType">
                <MudText Inline="true">@battleLogType</MudText>
            </MudSelectItem>
        }
    </MudSelect>
    <MudSelect Class="battle-log-file" Label="Log file" @bind-Value="SelectedBattleResult" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (var filename in BattleResults)
        {
            var details = GetLogDetails(filename);
            <MudSelectItem Value="filename">
                <div class="battle-log-option" title="@filename">
                    @if (details is { } detail)
                    {
                        <span class="battle-log-option-heading">
                            <span class="battle-log-option-name">@detail.Name</span>
                            <span class="battle-log-option-result">@detail.Result</span>
                        </span>
                        <time class="battle-log-option-time" datetime="@detail.Time.ToString("O")">@detail.Time.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time>
                    }
                    else
                    {
                        <span class="battle-log-option-filename">@filename</span>
                    }
                </div>
            </MudSelectItem>
        }
    </MudSelect>
</div>
</div>

<iframe id="log_viewer" class="battle-log-viewer" title="Battle Log Viewer" src="@GameConfig.Value.BattleLogViewerUrl"></iframe>
</div>
