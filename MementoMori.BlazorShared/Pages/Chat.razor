@page "/Chat"
@using MementoMori.Chat
@using MementoMori.BlazorShared.Components
@using MementoMori.Ortega.Share
@using MementoMori.Ortega.Share.Data.Chat
@using MementoMori.Ortega.Share.Enums
@inherits AccountComponent
@implements IAsyncDisposable

<PageTitle>@Tr("[CommonHeaderChatLabel]")</PageTitle>

<div class="chat-page">
    <div class="chat-heading">
        <MudText Typo="Typo.h5">@Tr("[CommonHeaderChatLabel]")</MudText>
        <span class="chat-status" role="status" data-testid="chat-status">
            <span class="chat-status-dot @(_snapshot.Connected ? "connected" : "")"></span>@_snapshot.Status
        </span>
        <MudSpacer />
        <MudButton OnClick="Reconnect" Disabled="@(!Funcs.LoginOk)" StartIcon="@Icons.Material.Filled.Refresh">@ResourceStrings.Reconnect</MudButton>
        <MudButton OnClick="() => _showSettings = !_showSettings" data-testid="chat-settings-toggle" Disabled="@_restoreChannel" StartIcon="@Icons.Material.Filled.TextFields">@Tr("[ChatSettingDialogTitle]")</MudButton>
    </div>

    @if (!Funcs.LoginOk)
    {
        <MudAlert Severity="Severity.Info">@ResourceStrings.PleaseLogin <MudLink Href="/">@Tr("[CommonFooterHomeButtonLabel]")</MudLink></MudAlert>
    }
    @if (!string.IsNullOrEmpty(_error ?? _snapshot.Error))
    {
        <MudAlert Severity="Severity.Warning" Dense="true">@(_error ?? _snapshot.Error)</MudAlert>
    }
    @if (_details != null)
    {
        <MudAlert Severity="Severity.Info" ShowCloseIcon="true" CloseIconClicked="() => _details = null"><span style="white-space: pre-wrap">@_details</span></MudAlert>
    }
    @if (_showSettings)
    {
        <div class="chat-settings">
            <div class="chat-size-control">
                <label for="chat-text-size">@Tr("[ChatSettingTypeFontSize]")</label>
                <input id="chat-text-size" type="range" min="12" max="24" step="1" @bind="_textSize" @bind:event="oninput" @bind:after="SaveAppearance" />
                <output for="chat-text-size">@_textSize px</output>
            </div>
            <div class="chat-size-control">
                <label for="chat-sticker-size">@ResourceStrings.ChatStickerSize</label>
                <input id="chat-sticker-size" type="range" min="24" max="96" step="1" @bind="_stickerSize" @bind:event="oninput" @bind:after="SaveAppearance" />
                <output for="chat-sticker-size">@_stickerSize px</output>
            </div>
            <div class="chat-compose-actions">
                <span class="chat-muted">@ResourceStrings.ChatAppearanceHint</span>
                <MudButton Size="Size.Small" OnClick="ResetAppearance">@Tr("[ChatSettingResetFontSizeButtonLabel]")</MudButton>
            </div>
            <details class="chat-game-settings">
                <summary>@ResourceStrings.ChatGameFontSize</summary>
                <select id="chat-game-font-size" aria-label="@ResourceStrings.ChatGameFontSize" @bind="_fontSize">
                    @foreach (var size in new[] { 15, 20, 25, 30 }) { <option value="@size">@size</option> }
                </select>
                <MudButton OnClick="SaveSettings" Disabled="@(_busy || !_snapshot.Connected)" Variant="Variant.Outlined">@ResourceStrings.SyncToGame</MudButton>
            </details>
        </div>
    }

    @if (_restoreChannel)
    {
        <div class="chat-loading" role="status">@ResourceStrings.ChatRestoringChannel</div>
    }
    else
    {
    <nav class="chat-channels" aria-label="@ResourceStrings.ChatChannels">
        @foreach (var channel in Channels)
        {
            <MudButton Variant="@(channel == _channel ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                       OnClick="() => ChangeChannel(channel)" Disabled="_busy" data-channel="@channel">@ChannelName(channel)
                @if (channel == ChatType.Private && _snapshot.Contacts.Any(c => c.ExistUnread)) { <span class="chat-unread" aria-label="@ResourceStrings.UnreadPrivateMessages">●</span> }
            </MudButton>
        }
    </nav>

    <div class="chat-workspace @(_channel == ChatType.Private ? "with-contacts" : "")">
        @if (_channel == ChatType.Private)
        {
            <aside class="chat-contacts" aria-label="@ResourceStrings.PrivateConversations">
                <div class="chat-contact-tools">
                    <MudButton Size="Size.Small" OnClick="TogglePlayers" Disabled="@(_busy || !_snapshot.Connected)" aria-expanded="@_showPlayers.ToString().ToLowerInvariant()">@(_showPlayers ? Tr("[CommonCloseLabel]") : Tr("[ChatSelectPlayer]"))</MudButton>
                    <MudButton Size="Size.Small" OnClick="RefreshContacts" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[BountyQuestUpdateExecution]")</MudButton>
                </div>
                @if (_showPlayers)
                {
                <div class="chat-new-contact">
                    <label for="chat-player-id">@Tr("[CommonPlayerIdLabel]")</label>
                    <input id="chat-player-id" inputmode="numeric" @bind="_targetInput" placeholder="@Tr("[GuildMemberRecruitInputMessage]")" />
                    <MudButton OnClick="AddPrivate" Size="Size.Small" Disabled="@(_busy || !_snapshot.Connected)">@ResourceStrings.StartPrivateChat</MudButton>
                </div>
                @if (_players.Count > 0)
                {
                    <label for="chat-player-picker">@Tr("[ChatAddButton]")</label>
                    <select id="chat-player-picker" value="" @onchange="SelectPlayer">
                        <option value="">@Tr("[ChatSelectPlayer]")</option>
                        @foreach (var player in _players) { <option value="@player.PlayerId">@player.PlayerName · @player.PlayerId</option> }
                    </select>
                }
                }
                @foreach (var contact in _snapshot.Contacts)
                {
                    <button type="button" class="chat-contact @(contact.PlayerInfo.PlayerId == _target ? "selected" : "")"
                            @onclick="() => SelectPrivate(contact.PlayerInfo.PlayerId)" disabled="@_busy">
                        <PlayerAvatar IconId="contact.PlayerInfo.MainCharacterIconId" Name="@contact.PlayerInfo.PlayerName" Size="32" />
                        <span class="chat-contact-copy"><span>@PlayerName(contact.PlayerInfo.PlayerName, contact.PlayerInfo.PlayerId)</span><small>@contact.PlayerInfo.PlayerId</small></span>
                        @if (contact.ExistUnread) { <span class="chat-unread" aria-label="@ResourceStrings.Unread">●</span> }
                    </button>
                }
                @if (_snapshot.Contacts.Count == 0) { <p class="chat-muted">@ResourceStrings.NoPrivateConversations</p> }
            </aside>
        }

        <section class="chat-conversation" aria-label="@ResourceStrings.CurrentConversation">
            <div class="chat-conversation-layout @(_showEmoticons ? "with-stickers" : "")">
            <div class="chat-conversation-heading">
                <strong>@ConversationName</strong>
                <span class="chat-muted">@string.Format(ResourceStrings.ChatMessageCountFormat, _snapshot.Messages.Count)</span>
                <MudSpacer />
                @if (_channel == ChatType.Guild)
                {
                    <MudButton OnClick="OpenGuildInfo" Disabled="@(!_snapshot.Connected)" StartIcon="@Icons.Material.Outlined.Campaign" Size="Size.Small" aria-haspopup="dialog" aria-controls="chat-guild-info">@GuildInfoTabs</MudButton>
                }
                @if (_channel == ChatType.Private && _target > 0)
                {
                    <MudButton OnClick="RemovePrivate" Disabled="@(_busy || !_snapshot.Connected)" Size="Size.Small">@Tr("[ChatPlayerListRemoveDialogTitle]")</MudButton>
                }
            </div>
            <div class="chat-history">
            <div @ref="_messageElement" class="chat-messages" role="log" aria-live="polite" aria-relevant="additions text" tabindex="0" data-testid="chat-messages">
                @if (_channel == ChatType.Private && _target > 0)
                {
                    <div class="chat-history-button">
                        <MudButton OnClick="LoadOlder" Size="Size.Small" Disabled="@(_busy || !_snapshot.Connected || _noOlder || _snapshot.Messages.Count >= ChatSession.HistoryLimit)">
                            @(_noOlder ? ResourceStrings.NoOlderMessages : _snapshot.Messages.Count >= ChatSession.HistoryLimit ? ResourceStrings.HistoryLimitReached : ResourceStrings.LoadOlderMessages)
                        </MudButton>
                    </div>
                }
                @if (_snapshot.Messages.Count == 0)
                {
                    <p class="chat-empty">@(_channel == ChatType.Private && _target == 0 ? Tr("[ChatPlayerEmpty]") : _snapshot.Connected ? Tr("[ChatMessageEmpty]") : ResourceStrings.ChatLoadsAfterConnect)</p>
                }
                @{ string? previousDate = null; }
                @foreach (var entry in _snapshot.Messages)
                {
                    var message = entry.ChatInfo;
                    var date = FormatTime(message.LocalTimeStamp, "yyyy-MM-dd");
                    if (date != previousDate)
                    {
                        <div class="chat-day-divider"><span>@date</span></div>
                        previousDate = date;
                    }
                    if (IsSystemMessage(message))
                    {
                        <div class="chat-system-message" style="font-size: @(Math.Max(12, _textSize - 2))px" @key="(message.PlayerId, message.LocalTimeStamp)">
                            <time>@FormatTime(message.LocalTimeStamp, "HH:mm")</time><span>@MessageText(message)</span>
                        </div>
                        continue;
                    }
                    var own = message.PlayerId > 0 && message.PlayerId == _snapshot.PlayerId;
                    <article class="chat-message @(own ? "own" : "")" @key="(message.PlayerId, message.LocalTimeStamp)">
                        <div class="chat-message-avatar"><PlayerAvatar IconId="message.CharacterId" Name="@message.PlayerName" /></div>
                        <div class="chat-message-content">
                        <div class="chat-message-meta">
                            <button class="chat-sender" type="button" @onclick="() => StartPrivate(message.PlayerId)" disabled="@(own || message.PlayerId <= 0 || _busy)">
                                @PlayerName(message.PlayerName, message.PlayerId)@(own ? ResourceStrings.Me : "")
                            </button>
                            @if (!string.IsNullOrEmpty(message.GuildName)) { <span>[@message.GuildName]</span> }
                            <time title="@FormatTime(message.LocalTimeStamp)">@FormatTime(message.LocalTimeStamp, "HH:mm")</time>
                            @if (entry.IsAnnounced) { <span title="@Tr("[ChatAnnounceListTabLabel]")">📌</span> }
                        </div>
                        <div class="chat-bubble @(IsStickerMessage(message) ? "sticker-only" : "")" style="font-size: @(DisplayFontSize)px">
                            @if (!string.IsNullOrWhiteSpace(MessageText(message)))
                            {
                                <p><ChatText Text="@MessageText(message)" StickerSize="_stickerSize" /></p>
                            }
                            @if (message.ChatGuildNoteInfo is { } note)
                            {
                                <div class="chat-guild-note">
                                    <strong>@string.Format(ResourceStrings.GuildNoteFormat, string.IsNullOrWhiteSpace(note.Title) ? ResourceStrings.UntitledNote : note.Title)</strong>
                                    <p>@note.Content</p>
                                </div>
                            }
                            @if (message.ChatRecruitGuildMemberInfo is { } recruit)
                            {
                                <p>@Tr("[ChatGuildRecruitTitle]") @recruit.GuildName (@Tr("[CommonLevelWithPeriodFormat]", recruit.GuildLv))</p><p>@recruit.RecruitMessage</p>
                            }
                            @if (message.ChatMusicPlaylistInfo is { } playlist)
                            {
                                <p>♫ @playlist.PlaylistName · @Tr("[MusicPlayerMusicCountFormat]", playlist.MusicCount)</p><p>@Tr("[MusicPlayerSharedPlaylistConfirmShareCodeFormat]", playlist.PlaylistShareCode)</p>
                            }
                            @if (message.ChatBattleInfo is { } battle)
                            {
                                <p>@Tr("[BattleReportTitle]") · @BattleTypeName(battle.ChatBattlePropertyInfo?.BattleType)</p>
                                @foreach (var party in battle.ChatBattlePartyInfoList ?? []) { <p>@party.PlayerName · @Tr(party.IsWin ? "[BattleReportWinLabel]" : "[BattleReportLoseLabel]")</p> }
                                <MudButton Size="Size.Small" OnClick="() => DownloadBattle(message)" Disabled="@(_busy || !_snapshot.Connected)">@ResourceStrings.DownloadBattleReport</MudButton>
                                <MudButton Size="Size.Small" OnClick="() => PrepareBattleShare(message)" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[BattleReportShareChatSelectTitle]")</MudButton>
                            }
                        </div>
                        @if (_channel == ChatType.Guild && message.PlayerId > 0)
                        {
                            <div class="chat-message-actions">
                                <ChatReactions Entry="entry" Disabled="@(_busy || !_snapshot.Connected)" OnReact="reaction => React(message, reaction)" OnDetails="() => ReactionDetails(message)" />
                                @if (entry.IsAnnounced ? CanDeleteAnnouncement(message) : CanAnnounce(message))
                                {
                                    <MudMenu>
                                        <ActivatorContent><MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" aria-label="@ResourceStrings.MessageActions" title="@ResourceStrings.MessageActions" /></ActivatorContent>
                                        <ChildContent>
                                            <MudMenuItem OnClick="() => SetAnnouncement(message, !entry.IsAnnounced)" Disabled="@(_busy || !_snapshot.Connected)">@(entry.IsAnnounced ? ResourceStrings.RemoveAnnouncement : ResourceStrings.SetAsAnnouncement)</MudMenuItem>
                                        </ChildContent>
                                    </MudMenu>
                                }
                            </div>
                        }
                        </div>
                    </article>
                }
            </div>
            </div>

            @if (_shareBattle != null)
            {
                <div class="chat-share">
                    <span>@Tr("[BattleReportShareChatSelectMessage]")</span>
                    <select aria-label="@Tr("[BattleReportShareChatSelectTitle]")" @bind="_shareChannel">
                        @foreach (var channel in Channels) { <option value="@channel">@ChannelName(channel)</option> }
                    </select>
                    @if (_shareChannel == ChatType.Private)
                    {
                        <input aria-label="@Tr("[CommonPlayerIdLabel]")" inputmode="numeric" @bind="_shareTarget" placeholder="@Tr("[CommonPlayerIdLabel]")" />
                    }
                    <MudButton OnClick="ShareBattle" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[BattleReportShareConfirmYesButton]")</MudButton>
                    <MudButton OnClick="() => _shareBattle = null">@Tr("[CommonCancelLabel]")</MudButton>
                </div>
            }
            <div class="chat-composer">
                <label for="chat-message-input">@string.Format(ResourceStrings.SendToFormat, ConversationName)</label>
                <textarea id="chat-message-input" @ref="_inputElement" @bind="Draft" @bind:event="oninput" @onkeydown="MessageKeyDown" maxlength="80" rows="2"
                          placeholder="@Tr("[ChatInputTextPlaceHolderLabel]")" disabled="@(!_snapshot.Connected || _busy || (_channel == ChatType.Private && _target == 0))"></textarea>
                @if (ChatEmoticons.Split(Draft).Any(part => ChatEmoticons.TryGetId(part, out _)))
                {
                    <div class="chat-draft-preview" style="font-size: @(_textSize)px"><span class="chat-muted">@ResourceStrings.Preview</span><ChatText Text="@Draft" StickerSize="_stickerSize" /></div>
                }
                <div class="chat-compose-actions">
                    <span class="chat-muted">Ctrl+Enter @Tr("[ChatSendButton]") · @Draft.Length/80</span>
                    <span class="chat-result" role="status">@_result</span>
                    <MudSpacer />
                    <div class="chat-send-actions" @onkeydown="EmoticonKeyDown">
                        <MudButton @ref="_emoticonButton" Class="chat-emoticon-toggle" StartIcon="@Icons.Material.Filled.SentimentSatisfiedAlt" OnClick="ToggleEmoticons" Disabled="@(_busy || !_snapshot.Connected)"
                                   aria-expanded="@_showEmoticons.ToString().ToLowerInvariant()" aria-controls="chat-emoticon-picker" data-testid="chat-emoticons-toggle">@Tr("[HelpHeadLine5302]")</MudButton>
                        <MudButton OnClick="Send" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSend)" StartIcon="@Icons.Material.Filled.Send" data-testid="chat-send">@(_busy ? ResourceStrings.Processing : Tr("[ChatSendButton]"))</MudButton>
                    </div>
                </div>
            </div>
            @if (_showEmoticons)
            {
                <aside id="chat-emoticon-picker" class="chat-emoticons" aria-label="@Tr("[HelpHeadLine5302]")" @onkeydown="EmoticonKeyDown">
                    <div class="chat-emoticon-body">
                        <div class="chat-contact-tools">
                            <div class="chat-emoticon-tabs" role="group" aria-label="@Tr("[GuildNoteCategory]")">
                                <button type="button" class="@(_emoticonTab == 1 ? "selected" : "")" aria-pressed="@((_emoticonTab == 1).ToString().ToLowerInvariant())" @onclick="() => _emoticonTab = 1">@ResourceStrings.StickerTabCat</button>
                                <button type="button" class="@(_emoticonTab == 2 ? "selected" : "")" aria-pressed="@((_emoticonTab == 2).ToString().ToLowerInvariant())" @onclick="() => _emoticonTab = 2">@Tr("[CommonHeaderCharacterListLabel]")</button>
                            </div>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseEmoticons" aria-label="@Tr("[CommonCloseLabel]")" title="@Tr("[CommonCloseLabel]")" />
                        </div>
                        <p class="chat-muted">@ResourceStrings.StickerPickerHint</p>
                        <div class="chat-emoticon-grid">
                            @foreach (var id in EmoticonIds)
                            {
                                var unlocked = _chat.IsEmoticonUnlocked(id);
                                <button type="button" @onclick="() => InsertEmoticon(id)" disabled="@(!unlocked || _busy)" aria-label="@string.Format(ResourceStrings.InsertStickerFormat, id)" title="@(unlocked ? string.Format(ResourceStrings.StickerFormat, id) : ResourceStrings.NotUnlocked)">
                                    <span style="@ChatEmoticons.Style(id, 64)" role="img" aria-label="@string.Format(ResourceStrings.StickerFormat, id)"></span>
                                </button>
                            }
                        </div>
                    </div>
                </aside>
            }
            </div>
        </section>
    </div>
    <p class="chat-footnote">@string.Format(ResourceStrings.ChatHistoryFootnote, ChatSession.HistoryLimit)</p>
    }
</div>


<MudDialog @ref="_guildDialog" @bind-Visible="_showGuildInfo" Options="GuildDialogOptions" Class="chat-guild-dialog" ContentClass="pa-0 ma-0" ContentStyle="overflow: hidden;">
    <TitleContent>
        <div class="chat-guild-title" @onkeydown="GuildInfoKeyDown">
            <div>
                <h2 id="chat-guild-dialog-title">@ResourceStrings.GuildActivity</h2>
                <p>@GuildInfoTabs</p>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _showGuildInfo = false" aria-label="@Tr("[CommonCloseLabel]")" title="@Tr("[CommonCloseLabel]")" />
        </div>
    </TitleContent>
    <DialogContent>
        <div id="chat-guild-info" class="chat-guild-info" @onkeydown="GuildInfoKeyDown">
            <div class="chat-guild-toolbar">
                <span class="chat-muted">@Tr("[MyPagePlayerInformationServerTimeLabel]").Trim()</span>
                <MudSpacer />
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadGuildInfo" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[BountyQuestUpdateExecution]")</MudButton>
            </div>
            @if (!string.IsNullOrEmpty(_error ?? _snapshot.Error))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mx-4 mb-2" role="alert">@(_error ?? _snapshot.Error)</MudAlert>
            }
            @if (_details != null)
            {
                <MudAlert Severity="Severity.Info" ShowCloseIcon="true" CloseIconClicked="() => _details = null" Class="mx-4 mb-2"><span class="chat-guild-details">@_details</span></MudAlert>
            }
            @if (!string.IsNullOrEmpty(_result))
            {
                <div class="chat-guild-result" role="status">@_result</div>
            }
            @if (_busy)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="@ResourceStrings.Processing" />
            }
            <MudTabs Class="chat-guild-tabs" @bind-ActivePanelIndex="_guildTab" Elevation="0" MinimumTabWidth="100px" KeepPanelsAlive="true">
                <MudTabPanel Text="@($"{Tr("[ChatAnnounceListTabLabel]")} · {_announcements.Count}")">
                    <div class="chat-guild-scroll">
                        @foreach (var announcement in _announcements)
                        {
                            var message = announcement.GuildChatInfo.ChatInfo;
                            var menuKey = (message.PlayerId, message.LocalTimeStamp);
                            <article class="chat-announcement chat-guild-card" @key="menuKey">
                                <div class="chat-card-heading">
                                    <PlayerAvatar IconId="message.CharacterId" Name="@message.PlayerName" Size="28" />
                                    <strong>@PlayerName(message.PlayerName, message.PlayerId)</strong>
                                    <MudSpacer />
                                    @if (CanDeleteAnnouncement(message))
                                    {
                                        <div @onkeydown="args => AnnouncementMenuKeyDown(args, menuKey)" @onkeydown:stopPropagation="_announcementMenuOpen">
                                            <MudMenu @ref="_announcementMenus[menuKey]" OpenChanged="open => _announcementMenuOpen = open">
                                                <ActivatorContent>
                                                    <MudIconButton @ref="_announcementMenuButtons[menuKey]" Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" OnClick="() => _announcementMenuOpen = true" aria-label="@ResourceStrings.MessageActions" title="@ResourceStrings.MessageActions" />
                                                </ActivatorContent>
                                                <ChildContent>
                                                    <div @onkeydown="args => AnnouncementMenuKeyDown(args, menuKey)" @onkeydown:stopPropagation="_announcementMenuOpen">
                                                        <MudMenuItem OnClick="() => SetAnnouncement(message, false)" Disabled="@(_busy || !_snapshot.Connected)">@ResourceStrings.RemoveAnnouncement</MudMenuItem>
                                                    </div>
                                                </ChildContent>
                                            </MudMenu>
                                        </div>
                                    }
                                </div>
                                <div class="chat-announcement-body" style="font-size: @(_textSize)px">
                                    <ChatText Text="@MessageText(message)" StickerSize="_stickerSize" />
                                    @if (message.ChatGuildNoteInfo is { } note)
                                    {
                                        <div class="chat-guild-note">
                                            <strong>@string.Format(ResourceStrings.GuildNoteFormat, string.IsNullOrWhiteSpace(note.Title) ? ResourceStrings.UntitledNote : note.Title)</strong>
                                            <p>@note.Content</p>
                                        </div>
                                    }
                                </div>
                                <p class="chat-entry-meta chat-muted" title="@string.Format(ResourceStrings.OriginalMessageTimeFormat, FormatTime(message.LocalTimeStamp))">
                                    @string.Format(ResourceStrings.AnnouncedAtFormat, FormatTime(announcement.RegisterLocalTimestamp))
                                </p>
                                <div class="chat-announcement-reactions">
                                    <ChatReactions Entry="announcement.GuildChatInfo" Disabled="@(_busy || !_snapshot.Connected)" OnReact="reaction => React(message, reaction)" OnDetails="() => ReactionDetails(message)" />
                                </div>
                            </article>
                        }
                        @if (_announcements.Count == 0)
                        {
                            <div class="chat-panel-empty"><MudIcon Icon="@Icons.Material.Outlined.Campaign" /><p>@ResourceStrings.NoGuildAnnouncements</p></div>
                        }
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@($"{Tr("[ChatSurveyListTabLabel]")} · {_surveys.Count}")">
                    <div class="chat-guild-scroll">
                        @foreach (var survey in _surveys)
                        {
                            var open = VotingOpen(survey);
                            <article class="chat-survey chat-guild-card">
                                <div class="chat-card-heading">
                                    <span class="chat-card-symbol"><MudIcon Icon="@Icons.Material.Filled.Poll" Size="Size.Small" /></span>
                                    <strong>@survey.Content</strong>
                                    <MudSpacer />
                                    <span class="chat-survey-status @(open ? "open" : "")">@Tr(open ? survey.IsVoted ? "[GuildSurveyVoteStatusVoted]" : "[GuildSurveyVoteStatusNotVoted]" : "[GuildSurveyVoteStatusEnd]")</span>
                                </div>
                                <p class="chat-entry-meta chat-muted">@survey.CreateSurveyPlayerInfo?.PlayerName · @string.Format(ResourceStrings.CreatedAtFormat, FormatTime(survey.CreateLocalTimestamp))</p>
                                <div class="chat-vote-options">
                                    @foreach (var choice in survey.ChoiceMap ?? [])
                                    {
                                        var count = Math.Max(0, survey.VoteCountMap?.GetValueOrDefault(choice.Key) ?? 0);
                                        var selected = _surveyChoices.TryGetValue(survey.SurveyGuid, out var value) && value == choice.Key;
                                        <label class="chat-vote-option @(selected ? "selected" : "")">
                                            <div class="chat-vote-label">
                                                @if (open && !survey.IsVoted)
                                                {
                                                    <input type="radio" name="@($"survey-{survey.SurveyGuid}")" checked="@selected"
                                                           @onchange="() => _surveyChoices[survey.SurveyGuid] = choice.Key" disabled="@_busy" />
                                                }
                                                <span>@choice.Value</span>
                                                <span class="chat-vote-count">@Tr("[PopularityVoteResultCountFormat]", count) · @VotePercent(survey, choice.Key)%</span>
                                            </div>
                                            <div class="chat-vote-track" aria-hidden="true"><div style="@($"width:{VotePercent(survey, choice.Key)}%")"></div></div>
                                        </label>
                                    }
                                </div>
                                <div class="chat-vote-footer">
                                    <span class="chat-muted">@string.Format(ResourceStrings.ParticipantsFormat, VoteTotal(survey)) · @Tr("[GuildSurveyVoteLimitLabel]") @FormatTime(survey.VotingEndLocalTimestamp)</span>
                                    <MudSpacer />
                                    <MudButton Size="Size.Small" OnClick="() => SurveyDetails(survey)" Disabled="@(_busy || !_snapshot.Connected)">@(_surveyDetails.ContainsKey(survey.SurveyGuid) ? Tr("[CommonCloseLabel]") : Tr("[GuildSurveyDetailButtonLabel]"))</MudButton>
                                    @if (open && !survey.IsVoted)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="() => Vote(survey)" Disabled="@(_busy || !_snapshot.Connected || !_surveyChoices.ContainsKey(survey.SurveyGuid))">@Tr("[GuildSurveyInputConfirmButtonLabel]")</MudButton>
                                    }
                                </div>
                                @if (_surveyDetails.TryGetValue(survey.SurveyGuid, out var details)) { <p class="chat-vote-details">@details</p> }
                            </article>
                        }
                        @if (_surveys.Count == 0)
                        {
                            <div class="chat-panel-empty"><MudIcon Icon="@Icons.Material.Outlined.Poll" /><p>@Tr("[GuildSurveyNotExistMessage]")</p></div>
                        }
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@($"{Tr("[ChatGuildNoteTabLabel]")} · {_guildNotes.Count}")">
                    <div class="chat-guild-scroll">
                        <div class="chat-compose-actions">
                            <span class="chat-muted">@_guildNotes.Count/@OrtegaConst.GuildNote.MaxGuildNoteCount</span>
                            <MudSpacer />
                            <MudButton Size="Size.Small" OnClick="LoadGuildNotes" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[BountyQuestUpdateExecution]")</MudButton>
                            @if (CanManageGuildNotes)
                            {
                                <MudButton Size="Size.Small" OnClick="() => BeginGuildNote()" data-testid="chat-note-new" Disabled="@(_busy || !_snapshot.Connected || _guildNotes.Count >= OrtegaConst.GuildNote.MaxGuildNoteCount)">@Tr("[GuildNoteAdd]")</MudButton>
                            }
                        </div>
                        @if (_editingGuildNoteId != null)
                        {
                            <form class="chat-note-editor chat-guild-card" @onsubmit="SaveGuildNote" @onsubmit:preventDefault="true">
                                <strong>@Tr("[GuildNoteSettingDialog]")</strong>
                                <label for="chat-note-title">@Tr("[GuildNoteTitle]") <span>@_noteTitle.Length/@OrtegaConst.GuildNote.MaxTitleLength</span></label>
                                <input id="chat-note-title" @ref="_noteTitleElement" @bind="_noteTitle" @bind:event="oninput" maxlength="@OrtegaConst.GuildNote.MaxTitleLength" disabled="@_busy" />
                                <label for="chat-note-category">@Tr("[GuildNoteCategory]")</label>
                                <select id="chat-note-category" @bind="_noteCategory" disabled="@_busy">
                                    <option value="@GuildNoteCategoryType.Normal">@Tr(GuildNoteCategoryType.Normal)</option>
                                    <option value="@GuildNoteCategoryType.Priority">@Tr(GuildNoteCategoryType.Priority)</option>
                                </select>
                                <label for="chat-note-content">@Tr("[GuildNoteContent]") <span>@_noteContent.Length/@OrtegaConst.GuildNote.MaxContentLength</span></label>
                                <textarea id="chat-note-content" @bind="_noteContent" @bind:event="oninput" maxlength="@OrtegaConst.GuildNote.MaxContentLength" rows="7" disabled="@_busy"></textarea>
                                <div class="chat-compose-actions">
                                    <MudButton ButtonType="ButtonType.Submit" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || !_snapshot.Connected || string.IsNullOrWhiteSpace(_noteTitle) || string.IsNullOrWhiteSpace(_noteContent))">@Tr(_editingGuildNoteId == 0 ? "[GuildNoteCreate]" : "[GuildNoteUpdate]")</MudButton>
                                    <MudButton Size="Size.Small" OnClick="CancelGuildNoteEdit" Disabled="_busy">@Tr("[GuildNoteDiscard]")</MudButton>
                                </div>
                            </form>
                        }
                        @foreach (var note in _guildNotes)
                        {
                            var reactions = new GuildChatInfo { MyChatReactionType = note.MyChatReactionType, ChatReactionCountMap = note.ChatReactionCountMap };
                            var index = _guildNotes.IndexOf(note);
                            <article class="chat-note-entry chat-guild-card" @key="note.GuildNoteId">
                                <div class="chat-card-heading">
                                    <PlayerAvatar IconId="note.IconId" Name="@note.PlayerName" Size="28" />
                                    <strong>@(string.IsNullOrWhiteSpace(note.Title) ? ResourceStrings.UntitledNote : note.Title)</strong>
                                    @if (note.GuildNoteCategoryType == GuildNoteCategoryType.Priority) { <span class="chat-survey-status open">@Tr(GuildNoteCategoryType.Priority)</span> }
                                </div>
                                <p class="chat-note-content">@note.Content</p>
                                <p class="chat-entry-meta chat-muted">@(note.IsDeletedPlayer ? ResourceStrings.DeletedPlayer : PlayerName(note.PlayerName, note.PlayerId)) · @string.Format(ResourceStrings.UpdatedAtFormat, FormatTime(note.UpdateLocalTimeStamp))</p>
                                <div class="chat-compose-actions">
                                    <ChatReactions Entry="reactions" Disabled="@(_busy || !_snapshot.Connected)" OnReact="reaction => ReactGuildNote(note, reaction)" OnDetails="() => GuildNoteReactionDetails(note)" />
                                    <MudSpacer />
                                    @if (CanManageGuildNotes)
                                    {
                                        <MudButton Size="Size.Small" OnClick="() => ShareGuildNote(note)" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[GuildNoteShareTitle]")</MudButton>
                                    }
                                    @if (CanEditGuildNote(note))
                                    {
                                        <MudButton Size="Size.Small" OnClick="() => BeginGuildNote(note)" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[Edit]")</MudButton>
                                    }
                                    @if (CanDeleteGuildNote(note))
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteGuildNote(note)" Disabled="@(_busy || !_snapshot.Connected)">@Tr("[DialogCommonFormationRemoveButton]")</MudButton>
                                    }
                                    @if (CanSortGuildNotes)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="@ResourceStrings.MoveNoteUp" title="@ResourceStrings.MoveNoteUp" OnClick="() => MoveGuildNote(note, -1)" Disabled="@(_busy || !_snapshot.Connected || index == 0)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="@ResourceStrings.MoveNoteDown" title="@ResourceStrings.MoveNoteDown" OnClick="() => MoveGuildNote(note, 1)" Disabled="@(_busy || !_snapshot.Connected || index == _guildNotes.Count - 1)" />
                                    }
                                </div>
                            </article>
                        }
                        @if (_guildNotes.Count == 0)
                        {
                            <div class="chat-panel-empty"><MudIcon Icon="@Icons.Material.Outlined.Description" /><p>@Tr("[GuildNoteNotExistMessage]")</p></div>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
</MudDialog>
