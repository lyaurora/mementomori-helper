@using MementoMori.Option
@using MementoMori.Common.Localization
@using MementoMori.Ortega.Common.Utils
@using MementoMori.Ortega.Share
@using MementoMori.Ortega.Share.Data.Item
@using MementoMori.Ortega.Share.Enums
@using MementoMori.BlazorShared.Components.Settings
@using ReactiveUI
@inject IWritableOptions<GameConfig> WritableGameConfig

@inherits MementoMori.BlazorShared.Models.AccountComponent
@page "/settings"

<MudGrid>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <AccountManagement/>
    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <AutoJobSwitch UserId="AccountSelection.CurrentUserId" OnJobsChanged="RefreshJobs"/>
    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <AutoJobCron OnJobsChanged="RefreshJobs"/>
    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <AutoJobNextExecution @ref="_autoJobNextExecution"/>
    </MudItem>
    @if (PlayerReady)
    {
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <GachaSettings @key="NetworkManager.PlayerId"/>
        </MudItem>
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <BountyQuest @key="NetworkManager.PlayerId"/>
        </MudItem>
    }
    else
    {
        @* per-character cards are hidden until login so defaults can't overwrite saved settings *@
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">@ResourceStrings.PleaseLogin</MudAlert>
        </MudItem>
    }
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <DungeonBattleSettings />
    </MudItem>
    @if (PlayerReady)
    {
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <LocalRaidSettings @key="NetworkManager.PlayerId"/>
        </MudItem>
    }
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <ShopSettings />
    </MudItem>
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <ItemsSetting/>
    </MudItem>
    @if (PlayerReady)
    {
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <PvpSettings LeagueType="0" @key="NetworkManager.PlayerId"/>
        </MudItem>
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <PvpSettings LeagueType="1" @key="NetworkManager.PlayerId"/>
        </MudItem>
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <FriendManageSettings @key="NetworkManager.PlayerId"/>
        </MudItem>
        <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
            <GuildTowerSettings @key="NetworkManager.PlayerId"/>
        </MudItem>
    }
    <MudItem xs="12" sm="12" md="6" lg="4" xl="3">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Class="panel-title"><MudIcon Class="panel-title-icon" Icon="@Icons.Material.Outlined.Tune" aria-hidden="true" /><span>@ResourceStrings.Others <span class="panel-scope">(@ResourceStrings.AllAccounts)</span></span></MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="settings-form">
                <MudNumericField Label="@ResourceStrings.AutoRequestDelay" @bind-Value="AutoRequestDelay" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense"></MudNumericField>
                <MudTextField T="string" @bind-Value="AssetsUrl" Label="@ResourceStrings.ResourceManager.GetString("ResourceServer")" Validation="@(new Func<string, string?>(ValidateHttpUrl))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="BattleLogViewerUrl" Label="@ResourceStrings.ResourceManager.GetString("BattleLogViewer")" Validation="@(new Func<string, string?>(ValidateHttpUrl))" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>


@code {
    private AutoJobNextExecution? _autoJobNextExecution;

    private Task RefreshJobs() => _autoJobNextExecution?.Refresh() ?? Task.CompletedTask;

    // Per-character cards load by PlayerId once; hide them until login and recreate them when PlayerId changes.
    private bool PlayerReady => NetworkManager.PlayerId > 0;

    protected override async Task AccountChanged()
    {
        TrackAccountSubscription(Funcs.WhenAnyValue(f => f.LoginOk).Subscribe(_ => InvokeAsync(StateHasChanged)));
        await InvokeAsync(StateHasChanged);
    }

    #region Other

    public int AutoRequestDelay
    {
        get => WritableGameConfig.Value.AutoRequestDelay;
        set => WritableGameConfig.Update(x => x.AutoRequestDelay = value);
    }

    private static string? ValidateHttpUrl(string value) => Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && uri.Scheme is "http" or "https" ? null : ResourceStrings.ResourceManager.GetString("HttpUrlRequired");

    private string AssetsUrl
    {
        get => WritableGameConfig.Value.AssetsUrl;
        set { if (ValidateHttpUrl(value) == null) WritableGameConfig.Update(x => x.AssetsUrl = value.TrimEnd('/')); }
    }

    private string BattleLogViewerUrl
    {
        get => WritableGameConfig.Value.BattleLogViewerUrl;
        set { if (ValidateHttpUrl(value) == null) WritableGameConfig.Update(x => x.BattleLogViewerUrl = value); }
    }

    #endregion


}
